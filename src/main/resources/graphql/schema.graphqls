"""
Read-only view of the Petclinic data. The fields mirror what the web pages show.
"""
type Query {
	"""
	Owners whose last name starts with the given text, one page at a time.
	An empty lastName matches every owner. Pages start at 1.
	"""
	owners(lastName: String = "", page: Int = 1, size: Int = 5): OwnerPage!

	"One owner with their pets and visits, or null when the id is unknown."
	owner(id: ID!): Owner

	"Every veterinarian of the clinic."
	vets: [Vet!]!

	"The kinds of pet the clinic treats, sorted by name."
	petTypes: [PetType!]!
}

"One page of owners."
type OwnerPage {
	owners: [Owner!]!
	"The page that was returned, starting at 1."
	page: Int!
	totalPages: Int!
	totalOwners: Int!
}

type Owner {
	id: ID!
	firstName: String!
	lastName: String!
	address: String!
	city: String!
	telephone: String!
	"The owner's pets, sorted by name."
	pets: [Pet!]!
}

type Pet {
	id: ID!
	name: String!
	birthDate: Date
	type: PetType
	"The pet's visits to the clinic, oldest first."
	visits: [Visit!]!
}

type PetType {
	id: ID!
	name: String!
}

type Visit {
	id: ID!
	date: Date!
	description: String!
}

type Vet {
	id: ID!
	firstName: String!
	lastName: String!
	"The vet's specialties, sorted by name."
	specialties: [Specialty!]!
}

type Specialty {
	id: ID!
	name: String!
}

"A calendar date in ISO-8601 format, for example 2013-01-04."
scalar Date

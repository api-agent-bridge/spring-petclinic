	gbifConceptAlternativeLabelsFromLatestRelease(
		"""
		The name of the vocabulary, for example LifeStage, Sex or EstablishmentMeans. gbifVocabularies lists them.
		"""
		vocabularyName: String!
		"The name of the concept, for example Adult in the vocabulary LifeStage."
		name: String!
		"Languages to filter by"
		lang: String
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): GbifLabelPage

	"""
	List all the hidden labels of the concept from the latest release of the vocabulary.
	Lists all hidden labels of the concept from the latest release of the vocabulary.
	"""
	gbifConceptHiddenLabelsFromLatestRelease(
		"""
		The name of the vocabulary, for example LifeStage, Sex or EstablishmentMeans. gbifVocabularies lists them.
		"""
		vocabularyName: String!
		"The name of the concept, for example Adult in the vocabulary LifeStage."
		name: String!
		"Only the hidden labels that contain this text."
		q: String
		"The page to return, starting at 1. A value below 1 returns the first page."
		page: Int! = 1
		"""
		The number of results on a page, from 1 to 50. A value outside that range is moved to the nearest limit.
		"""
		size: Int! = 10
	): GbifHiddenLabelPage

	"""
	Concept lookup.
	Lookup a concept given a specific value and an optional language.
	"""
	gbifLookupVocabularyConcepts(
		"""
		The name of the vocabulary, for example LifeStage, Sex or EstablishmentMeans. gbifVocabularies lists them.
		"""
		vocabularyName: String!
		"Value to do the lookup against to"
		q: String!
		"Lang to discriminate the lookup"
		lang: String
	): [GbifConceptLookupResult]

	"""
	Concept lookup in the latest release.
	Lookup a concept in the latest release of the vocabulary given a specific value and an optional language.
	"""
	gbifLookupVocabularyConceptsInLatestRelease(
		"""
		The name of the vocabulary, for example LifeStage, Sex or EstablishmentMeans. gbifVocabularies lists them.
		"""
		vocabularyName: String!
		"Value to do the lookup against to"
		q: String!
		"Lang to discriminate the lookup"
		lang: String
	): [GbifConceptLookupResult]

	# The GBIF literature: publications that cite GBIF data.

	"""
	Literature item by id.
	Retrieve details for a single literature item
	"""
	gbifLiterature(
		"UUID for the literature item"
		uuid: ID!
	): GbifLiteratureSearchResult

	"""
	Searches the scientific publications that use or cite GBIF data, by words, topic, country or year.
	Search literature.
	Full-text and parameterized search across all literature
	"""
	gbifSearchLiterature(
		"""
		The manner in which GBIF is cited in a paper.
		Make a facet query for available values.
		*This parameter may be repeated to search for multiple values.*
		"""
		citationType: [String!]
		"""
		Country or area of focus of study. Country codes are listed in our Country enum.
		*This parameter may be repeated to search for multiple values.*
		"""
		countriesOfCoverage: [GbifCountry!]
		"""
		Country or area of institution with which author is affiliated. Country codes are listed in our Country enum.
		*This parameter may be repeated to search for multiple values.*
		"""
		countriesOfResearcher: [GbifCountry!]
		"""
		Digital Object Identifier (DOI) of the literature item.
		*This parameter may be repeated to search for multiple values.*
		"""
		doi: [String!]
		"""
		GBIF dataset referenced in publication.
		*This parameter may be repeated to search for multiple values.*
		"""
		gbifDatasetKey: ID
		"""
		GBIF download referenced in publication.
		*This parameter may be repeated to search for multiple values.*
		"""
		gbifDownloadKey: [String!]
		"""
		All parent keys of any taxon that is the focus of the paper (see gbifTaxonKey)
		*This parameter may be repeated to search for multiple values.*
		"""
		gbifHigherTaxonKey: [Int!]
		"""
		GBIF network referenced in publication.
		*This parameter may be repeated to search for multiple values.*
		"""
		gbifNetworkKey: ID
		"""
		Any GBIF occurrence keys directly mentioned in a paper.
		*This parameter may be repeated to search for multiple values.*
		"""
		gbifOccurrenceKey: [Long!]
		"""
		GBIF dataset referenced in publication.
		*This parameter may be repeated to search for multiple values.*
		"""
		gbifProjectIdentifier: ID
		"""
		GBIF dataset referenced in publication.
		*This parameter may be repeated to search for multiple values.*
		"""
		gbifProgrammeAcronym: ID
		"""
		Key(s) from the GBIF backbone of taxa that are the focus of a paper.
		*This parameter may be repeated to search for multiple values.*
		"""
		gbifTaxonKey: [Int!]
		"""
		Type of literature, e.g. journal article.
		*This parameter may be repeated to search for multiple values.*
		"""
		literatureType: [GbifLiteratureType!]
		"Is the publication Open Access?"
		openAccess: Boolean
		"Has the publication undergone peer review?"
		peerReview: Boolean
		"""
		Publisher of journal.
		*This parameter may be repeated to search for multiple values.*
		"""
		publisher: [String!]
		"""
		Publisher whose dataset is referenced in publication.
		*This parameter may be repeated to search for multiple values.*
		"""
		publishingOrganizationKey: [ID!]
		"""
		Country of the publisher whose dataset is referenced in publication. Country codes are listed in our Country
		enum.
		*This parameter may be repeated to search for multiple values.*
		"""
		publishingCountry: [GbifCountry!]
		"""
		Relevance to GBIF community, see literature relevance.
		*This parameter may be repeated to search for multiple values.*
		"""
		relevance: [GbifLiteratureRelevance!]
		"""
		Journal of publication.
		*This parameter may be repeated to search for multiple values.*
		"""
		source: [String!]
		"""
		Topic of publication.
		*This parameter may be repeated to search for multiple values.*
		"""
		topics: [GbifLiteratureTopic!]
		"""
		Website of publication
		*This parameter may be repeated to search for multiple values.*
		"""
		websites: [String!]
		"""
		Year of publication. This can be a single range such as 2019,2021, or can be repeated to search multiple years.
		"""
		year: Int
		"""
		Language of publication. Language codes are listed in our Language enum.
		*This parameter may be repeated to search for multiple values.*
		"""
		language: String
		"""
		Date or date range when the publication was added. Format is ISO 8601, e.g., '2024-07-14' or
		'2024-07-14,2024-08-14'.
		"""
		added: String
		"""
		Date or date range when the publication was published. Format is ISO 8601, e.g., '2024-02-22' or
		'2024-02-22,2024-03-22'.
		"""
		published: String
		"""
		Date or date range when the publication was discovered. Format is ISO 8601, e.g., '2024-02-26' or
		'2024-02-26,2024-03-26'.
		"""
		discovered: String
		"""
		Date or date range when the publication was discovered. Format is ISO 8601, e.g., '2024-07-26' or
		'2024-07-26,2024-10-26'.
		"""
		modified: String
		"""
		Set hl=true to highlight terms matching the query when in fulltext search fields. The highlight will be an
		emphasis tag of class gbifHl.
		"""
		hl: Boolean
		"""
		A facet name used to retrieve the most frequent values for a field. This parameter may be repeated to request
		multiple facets.
		"""
		facet: [String!]
		"""
		Used in combination with the facet parameter. Set facetMinCount={#} to exclude facets with a count less than
		{#}.
		"""
		facetMinCount: Int
		"""
		Used in combination with the facet parameter. Set facetMultiselect=true to still return counts for values that
		are not currently filtered.
		"""
		facetMultiselect: Boolean
		"Facet parameters allow paging requests using the parameters facetOffset and facetLimit"
		facetLimit: Int
		"Facet parameters allow paging requests using the parameters facetOffset and facetLimit"
		facetOffset: Int
		"""
		Simple full text search parameter. The value for this parameter can be a simple word or a phrase. Wildcards are
		not supported
		"""
		q: String
	): GbifLiteratureSearchResult
}

"""
Changes to the Petclinic data. Each mutation applies the rules of the matching web form.
A value that breaks a rule returns one BAD_REQUEST error for each field, and the data stays as it was.
An id that does not exist returns a NOT_FOUND error.
"""
type Mutation {
	"""
	Registers a new owner. Every call registers one more owner,
	so calling it twice with the same input creates two owners.
	"""
	addOwner(input: AddOwnerInput!): Owner!

	"Replaces the details of an owner. Calling it again with the same input leaves the owner unchanged."
	updateOwner(input: UpdateOwnerInput!): Owner!

	"""
	Registers a new pet for an owner. An owner cannot have two pets with the same name,
	so a second call with the same input is refused.
	"""
	addPet(input: AddPetInput!): Pet!

	"Replaces the details of a pet. Calling it again with the same input leaves the pet unchanged."
	updatePet(input: UpdatePetInput!): Pet!

	"""
	Books a visit for a pet. Every call books one more visit,
	so calling it twice with the same input creates two visits.
	"""
	addVisit(input: AddVisitInput!): Visit!
}

"One page of owners."
type OwnerPage {
	"The owners on this page, sorted by id as a number."
	owners: [Owner!]!
	"The page that was returned, starting at 1."
	page: Int!
	"The number of pages available for the same filters and size."
	totalPages: Int!
	"The number of owners that match the filters, counted across every page."
	totalOwners: Int!
}

"One page of pets."
type PetPage {
	"The pets on this page, sorted by id as a number."
	pets: [Pet!]!
	"The page that was returned, starting at 1."
	page: Int!
	"The number of pages available for the same filters and size."
	totalPages: Int!
	"The number of pets that match the filters, counted across every page."
	totalPets: Int!
}

"A client of the clinic, with the pets they have registered."
type Owner {
	id: ID!
	firstName: String!
	lastName: String!
	"The street and house number, for example 110 W. Liberty St."
	address: String!
	"The city the owner lives in."
	city: String!
	"The owner's telephone number as ten digits, for example 6085551023."
	telephone: String!
	"The owner's pets, sorted by name."
	pets: [Pet!]!
	"""
	The off-leash dog zones of the City of Antwerp nearest to the owner's address, nearest first,
	within 2 km. The city's geocoder finds the address and the city's dog zone service lists the
	zones around it, both over SOAP. The list is empty when the geocoder cannot find the address,
	as for an owner outside Antwerp, and null when an Antwerp service cannot be reached.
	"""
	nearestDogZones(
		"How many zones to return, from 1 to 10."
		first: Int! = 3
	): [DogZone!]
}

"An animal that an owner has registered with the clinic."
type Pet {
	id: ID!
	name: String!
	"The day the pet was born, or null when the clinic has not recorded it."
	birthDate: Date
	"The kind of pet, or null when the clinic has not recorded it."
	type: PetType
	"The owner who registered the pet."
	owner: Owner!
	"The pet's visits to the clinic, oldest first."
	visits: [Visit!]!
	"The pet's latest visit, past or planned, or null until the first visit is booked."
	lastVisit: Visit
}

"A kind of pet the clinic treats, such as cat or dog."
type PetType {
	id: ID!
	"The name of the kind, for example hamster."
	name: String!
}

"A visit of a pet to the clinic, past or planned."
type Visit {
	id: ID!
	"The day of the visit."
	date: Date!
	"What the visit was for, for example a rabies shot."
	description: String!
}

"A veterinarian who works at the clinic."
type Vet {
	id: ID!
	firstName: String!
	lastName: String!
	"The vet's specialties, sorted by name. The list is empty for a vet without a specialty."
	specialties: [Specialty!]!
}

"An area of veterinary medicine a vet specialises in, such as radiology or surgery."
type Specialty {
	id: ID!
	"The name of the specialty, for example dentistry."
	name: String!
}

"""
An off-leash dog zone of the City of Antwerp. The city publishes the data in Dutch,
and the values are translated here.
"""
type DogZone {
	id: ID!
	name: String!
	street: String
	postalCode: String
	"The district of Antwerp, or the neighbouring municipality, that the zone lies in."
	district: String
	"The distance from the owner's address to the zone, in metres."
	distanceInMetres: Int!
	areaInSquareMetres: Int
	"How clean inspectors found the zone. Null when the city has not given the zone a clear rating."
	cleanliness: Rating
	lighting: Lighting
	"The heights of the fences in metres. A zone can have fences of different heights."
	fenceHeightsInMetres: [Float!]!
	fenceMaterial: String
	bins: Int
	benches: Int
	surface: String
}

"How clean inspectors found a dog zone."
enum Rating {
	GOOD
	ACCEPTABLE
	BAD
}

"The kind of lighting of a dog zone."
enum Lighting {
	DIRECT
	INDIRECT
	NONE
}

"The details of a new owner."
input AddOwnerInput {
	"At most 30 characters."
	firstName: String!
	"At most 30 characters."
	lastName: String!
	"The street and house number, at most 255 characters."
	address: String!
	"At most 80 characters."
	city: String!
	"Exactly ten digits, for example 6085551023."
	telephone: String!
}

"The new details of an existing owner. Every field replaces the stored value."
input UpdateOwnerInput {
	"The id of the owner to change."
	id: ID!
	"At most 30 characters."
	firstName: String!
	"At most 30 characters."
	lastName: String!
	"The street and house number, at most 255 characters."
	address: String!
	"At most 80 characters."
	city: String!
	"Exactly ten digits, for example 6085551023."
	telephone: String!
}

"The details of a new pet."
input AddPetInput {
	"The id of the owner the pet belongs to."
	ownerId: ID!
	"At most 30 characters, and different from the names of the owner's other pets."
	name: String!
	"The day the pet was born. A day after today is refused."
	birthDate: Date!
	"The id of the kind of pet, as the petTypes query lists them."
	typeId: ID!
}

"The new details of an existing pet. Every field replaces the stored value."
input UpdatePetInput {
	"The id of the pet to change."
	id: ID!
	"At most 30 characters, and different from the names of the owner's other pets."
	name: String!
	"The day the pet was born. A day after today is refused."
	birthDate: Date!
	"The id of the kind of pet, as the petTypes query lists them."
	typeId: ID!
}

"The details of a visit to book."
input AddVisitInput {
	"The id of the pet the visit is for."
	petId: ID!
	"The day of the visit, which must be after today. Leave it out to book the visit for tomorrow."
	date: Date
	"What the visit is for, at most 255 characters."
	description: String!
}

"A calendar date without a time zone, in the ISO-8601 pattern YYYY-MM-DD, for example 2013-01-04."
scalar Date @specifiedBy(url: "https://scalars.graphql.org/andimarek/local-date.html")

"""
A whole number of 64 bits, from -9,223,372,036,854,775,808 to 9,223,372,036,854,775,807. GBIF uses it for counts
and keys that pass the 2,147,483,647 of Int, such as the number of occurrences.
"""
scalar Long

"""
A medicine that EMA has evaluated for the EU market, for humans or for animals.
"""
type EmaMedicine {
	"Whether the medicine is for humans or for animals."
	category: EmaCategory
	"The name of the medicine, for example Orgovyx."
	name: String
	"EMA's product number, for example EMEA/H/C/005353. Veterinary medicines have numbers that start with EMEA/V/C."
	productNumber: String
	"The status of the medicine, for example Authorised, Withdrawn, Refused or Application withdrawn."
	status: String
	"The outcome of EMA's opinion while the European Commission has not decided yet, for example Positive."
	opinionStatus: String
	"The number of the latest procedure that changed the product information."
	latestProcedure: String
	"The international non-proprietary names (INN) or common names of the active substances."
	commonNames: [String!]!
	"The active substances."
	activeSubstances: [String!]!
	"The diseases and conditions the medicine treats, as MeSH terms."
	therapeuticAreas: [String!]!
	"The animal species a veterinary medicine is for, for example Dogs. EMA fills this for a small share of its veterinary medicines, so an empty list leaves the species unknown."
	targetSpecies: [String!]!
	"Whether EMA lists the medicine under patient safety."
	patientSafety: Boolean
	"The ATC codes of a human medicine, for example L02BX."
	atcCodes: [String!]!
	"The ATCvet code of a veterinary medicine, for example QI09AA07."
	atcVetCode: String
	"The pharmacotherapeutic groups of a human medicine, for example Endocrine therapy."
	pharmacotherapeuticGroups: [String!]!
	"The pharmacotherapeutic groups of a veterinary medicine, for example Immunologicals for suidae."
	veterinaryPharmacotherapeuticGroups: [String!]!
	"What the medicine is indicated for, in the words of its product information."
	therapeuticIndication: String
	"Whether EMA evaluated the medicine under accelerated assessment."
	acceleratedAssessment: Boolean
	"Whether the medicine is under additional monitoring, which its leaflet marks with a black triangle."
	additionalMonitoring: Boolean
	"Whether it is an advanced therapy medicinal product."
	advancedTherapy: Boolean
	"Whether it is a biosimilar medicine."
	biosimilar: Boolean
	"Whether it has a conditional marketing authorisation."
	conditionalApproval: Boolean
	"Whether it was authorised under exceptional circumstances."
	exceptionalCircumstances: Boolean
	"Whether it is a generic medicine."
	generic: Boolean
	"Whether it is an orphan medicine, for a rare disease."
	orphanMedicine: Boolean
	"Whether it received support under EMA's PRIME scheme for priority medicines."
	primePriorityMedicine: Boolean
	"The company that holds the marketing authorisation, applied for it, or develops the medicine."
	marketingAuthorisationHolder: String
	"The day of the latest decision of the European Commission on the medicine."
	commissionDecisionDate: Date
	"The day a rolling review of the medicine started."
	rollingReviewStartDate: Date
	"The day EMA started to evaluate the application."
	evaluationStartDate: Date
	"The day EMA's committee adopted its opinion."
	opinionDate: Date
	"The day the company withdrew its application."
	applicationWithdrawalDate: Date
	"The day the marketing authorisation was granted."
	authorisationDate: Date
	"The day the marketing authorisation was refused."
	refusalDate: Date
	"The day the marketing authorisation was withdrawn, expired, was revoked or lapsed."
	authorisationEndDate: Date
	"The day the marketing authorisation was suspended."
	suspensionDate: Date
	"The revision number of the product information."
	revisionNumber: Int
	"The day EMA first published the medicine."
	firstPublishedDate: Date
	"The day EMA last updated the medicine, or null when it has not been updated."
	lastUpdatedDate: Date
	"The page of the medicine on the EMA website."
	url: String
}

"One page of EMA medicines. The medicines are sorted by the day of their latest change, the most recent first."
type EmaMedicinePage {
	"The medicines on this page."
	medicines: [EmaMedicine!]!
	"The page that was returned, starting at 1."
	page: Int!
	"The number of pages available for the same filters and size."
	totalPages: Int!
	"The number of medicines that match the filters, counted across every page."
	totalMedicines: Int!
}

"""
A document published on the EMA website, such as an assessment report, a product information leaflet or a press release.
"""
type EmaDocument {
	"EMA's identifier of the document."
	id: String
	"The title of the document."
	name: String
	"The type of document, for example assessment-report, product-information or press-release."
	type: String
	"The medicine an EPAR document belongs to. Null for other documents."
	medicineName: String
	"The product number of that medicine, for example EMEA/H/C/000619."
	productNumber: String
	"The status of the document, for example Adopted, Draft or unknown."
	status: String
	"The period of the public consultation on a draft, for example 2007-03-01 - 2007-11-01."
	consultationPeriod: String
	"EMA's reference number of the document, for example EMA/CHMP/261595/2012."
	referenceNumber: String
	"The day EMA first published the document."
	firstPublishedDate: Date
	"The day EMA last updated the document, or null when it has not been updated."
	lastUpdatedDate: Date
	"The address of the document file, in English."
	url: String
}

"One page of EMA documents. The documents are sorted by the day of their latest change, the most recent first."
type EmaDocumentPage {
	"The documents on this page."
	documents: [EmaDocument!]!
	"The page that was returned, starting at 1."
	page: Int!
	"The number of pages available for the same filters and size."
	totalPages: Int!
	"The number of documents that match the filters, counted across every page."
	totalDocuments: Int!
}

"""
An event that EMA organises or takes part in, such as a workshop or a committee meeting.
"""
type EmaEvent {
	"The title of the event."
	title: String
	"When the event takes place, as EMA writes it, for example Mon, Sep 21 2026, 1:30 - 5pm."
	dates: String
	"Whether the event is broadcast live."
	liveBroadcast: Boolean
	"Whether the event takes place online."
	online: Boolean
	"Where the event takes place, for example European Medicines Agency, Amsterdam, the Netherlands."
	location: String
	"The day EMA first published the event."
	firstPublishedDate: Date
	"The day EMA last updated the event, or null when it has not been updated."
	lastUpdatedDate: Date
	"The page of the event on the EMA website."
	url: String
}

"One page of EMA events. The events are sorted by the day of their latest change, the most recent first."
type EmaEventPage {
	"The events on this page."
	events: [EmaEvent!]!
	"The page that was returned, starting at 1."
	page: Int!
	"The number of pages available for the same filters and size."
	totalPages: Int!
	"The number of events that match the filters, counted across every page."
	totalEvents: Int!
}

"""
A general page of the EMA website, such as guidance on a procedure or an overview of a topic.
"""
type EmaWebsiteArticle {
	"The title of the page."

{"offset":0,"limit":2,"endOfRecords":false,"count":2165,"results":[{"key":4414,"type":"UPDATE","status":"APPLIED","entityKey":"cc775ae7-70ec-4a4e-aeaa-2653708ca2ac","entityName":"Universität Basel, Herbaria Basel","entityCountry":"CH","suggestedEntity":{"key":"cc775ae7-70ec-4a4e-aeaa-2653708ca2ac","code":"UNIBAS:HERBARIA","name":"Universität Basel, Herbaria Basel","description":"https://www.gbif.org/grscicoll/institution/cc775ae7-70ec-4a4e-aeaa-2653708ca2ac \nThe Herbaria Basel at the University of Basel contain three separate plant collections: the Herbarium of the University of Basel (BAS); the Herbarium of the Basel Botanical Society (BASBG); the Jany Renz Orchid Herbarium (RENZ). The Herbaria Basel are a part of the Department of Environmental Sciences of the University of Basel, and result from a collaboration between the University and the Basel Botanical Society. Our earliest specimens date from the 1570s, when Caspar Bauhin (1560-1624), one of the founding fathers of scientific botany, collected his first plants. The collection is still growing, and emphasizes the flora of Europe, Mediterranean, and Turkey, as well as orchids worldwide. The Herbaria Basel are registered Swiss Cultural Heritage of national importance. Global, with emphasis on the flora of Europe, Mediterranean, Turkey. Vascular plants, bryophytes, lichens","types":["Herbarium"],"active":true,"email":["contact@example.org","contact@example.org"],"phone":["+00 000 00 00 00"],"homepage":"https://herbarium.unibas.ch","catalogUrls":["https://herbarium.unibas.ch/en/examples/"],"apiUrls":[],"institutionalGovernances":["Academic"],"disciplines":[],"latitude":47.5272,"longitude":7.57155,"mailingAddress":{"key":3481,"address":"Schönbeinstrasse 6","city":"Basel","province":"BS","postalCode":"CH-4056","country":"CH"},"address":{"key":10213,"address":"Wuhrmattstrasse 13","city":"Bottmingen","province":"BL","postalCode":"CH-4103","country":"CH"},"additionalNames":["Herbarium","Herbarium Jany Renz","Herbari
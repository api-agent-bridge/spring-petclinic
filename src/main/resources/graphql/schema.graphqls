}

"A status value derived from a dataset or external source. E.g. IUCN Red List."
type GbifStatus {
	"The checklistbank dataset key for the dataset that the status is associated with"
	clbDatasetKey: String
	"The dataset alias for the dataset that the status is associated with"
	datasetAlias: String
	"The GBIF registry key (UUID) for the dataset that the status is associated with"
	datasetKey: String
	"The status value"
	status: String
	"The status code value"
	statusCode: String
	"The ID in the source dataset for this status. e.g. the IUCN ID for this taxon"
	sourceId: String
}

"Metadata about the index and software used to access the index through webservices"
type GbifAPIMetadata {
	"When the index was created. Typically the build date of the docker image"
	created: String
	"Software version information"
	buildInfo: GbifBuildInfo
	"Metadata about an specific section of the index (e.g. main or identifier index)"
	mainIndex: GbifIndexMetadata
	"Metadata about an specific section of the index (e.g. main or identifier index)"
	identifierIndexes: [GbifIndexMetadata]
	"Metadata about an specific section of the index (e.g. main or identifier index)"
	ancillaryIndexes: [GbifIndexMetadata]
}


	VETERINARY
}

"""
A notification of the EU's Rapid Alert System for Food and Feed (RASFF), as a search lists it.
The rasffNotification query returns its details.
"""
type RasffNotificationSummary {
	"The id of the notification, which the rasffNotification query takes."
	id: ID!
	"The public reference, for example 2026.8625."
	reference: String
	"What the notification is about, for example Foreign body in pet food for cats from Germany."
	subject: String
	"The day the European Commission validated the notification."
	validationDate: Date
	"The member of the RASFF network that sent the notification."
	notifyingCountry: RasffCountryRef
	"The category of the product, for example pet food."
	productCategory: RasffTerm
	"Whether the product is food, feed or food contact material."
	productType: RasffTerm
	"The kind of notification, for example alert notification."
	classification: RasffTerm
	"How serious the risk is, for example serious or not serious."
	riskDecision: RasffTerm
	"The countries the product came from."
	originCountries: [RasffCountryRef!]!
}

"One page of RASFF notifications, the most recently validated first."
type RasffNotificationPage {
	"The notifications on this page."
	notifications: [RasffNotificationSummary!]!
	"The page that was returned, starting at 1."
	page: Int!
	"The number of pages available for the same filters and size."
	totalPages: Int!
	"The number of notifications that match the filters, counted across every page."
	totalNotifications: Int!
}

"""
A RASFF notification with its details: the product, the hazards found in it, the risk, the countries involved
and the measures they took.
"""
type RasffNotification {
	"The id of the notification."
	id: ID!
	"The public reference, for example 2026.8625."
	reference: String
	"What the notification is about."
	subject: String
	"The day the European Commission validated the notification."
	validationDate: Date
	"The day of the latest change to the notification."
	lastUpdateDate: Date
	"The kind of notification, for example alert notification."
	classification: RasffTerm
	"Whether the product is food, feed or food contact material."
	productType: RasffTerm
	"What led to the notification, for example a consumer complaint or an official control on the market."
	basis: RasffTerm
	"The status in RASFF's own words, for example ec_validated."
	status: String
	"The product and what was found in it."
	product: RasffProduct
	"The assessment of the risk."
	risk: RasffRisk
	"The countries involved, with the part each one plays."
	countries: [RasffCountryInvolvement!]!
	"The follow-ups that members of the network sent after the notification."
	followUps: [RasffFollowUp!]!
	"Websites with information for consumers, run by the authorities of the countries involved."
	consumerInformationLinks: [String!]!
}

"The product of a RASFF notification."
type RasffProduct {
	"What the product is, for example cat food."
	name: String
	"The category of the product, for example pet food."
	category: RasffTerm
	"Whether and where the product was distributed, for example distribution to other member countries."
	distributionStatus: RasffTerm
	"What was found in the product."
	hazards: [RasffHazard!]!
	"The packaging, batches and weights of the product as it was sold."
	details: [RasffProductDetail!]!
	"What the authorities did about the product, such as a recall."
	measures: [RasffMeasure!]!
}

"A hazard found in a product."
type RasffHazard {
	"The hazard, for example zinc - too high content - composition."
	name: String
	"The category of the hazard, for example foreign bodies or composition."
	category: String
	"The measured value, as RASFF writes it, for example 336 +/-44."
	analyticalResult: String
	"The unit of the measured value, for example mg/kg - ppm."
	unit: String
	"The highest level the law permits, with its unit, for example 200 mg/kg - ppm."
	maximumPermittedLevel: String
	"The day the sample was taken."
	samplingDate: Date
}

"A description of a product as it was sold."
type RasffProductDetail {
	"The packaging or presentation, for example canned pet food."
	aspect: String
	"What the label says, for example a batch number."
	labelling: String
	"The weight of one package."
	weight: Float
	"The unit of the weight, for example g or kg."
	weightUnit: RasffTerm
	"How the product is kept, for example ambient."
	temperature: RasffTerm
}

"A measure that an authority took about a product."
type RasffMeasure {
	"The measure, for example recall from consumer."
	action: RasffTerm
	"The country whose authority took the measure."
	takenBy: RasffCountryRef
	"A page about the measure, such as a recall notice."
	url: String
}

"The assessment of the risk of a RASFF notification."
type RasffRisk {
	"How serious the risk is, for example serious or potential risk."
	decision: String
	"What was observed, in the words of the notifying country."
	hazardObserved: String
	"The number of people who fell ill. For pet food, RASFF counts the animals here."
	personsAffected: Int
	"The illness they had."
	illness: String
}

"A country involved in a RASFF notification."
type RasffCountryInvolvement {
	"The name of the country."
	country: String
	"The ISO 3166 alpha-2 code of the country."
	code: String
	"The parts the country plays: NOTIFYING, ORIGIN, DISTRIBUTION, FOR_FOLLOW_UP, FOR_ATTENTION or OPERATOR."
	roles: [String!]!
}

"A follow-up to a RASFF notification."
type RasffFollowUp {
	"The number of the follow-up, starting at 1."
	number: Int!
	"The day it was sent."
	date: Date
	"What the follow-up reports, for example outcome of investigations."
	type: RasffTerm
	"The authority that sent it: a country, or a region of one."
	sender: String
	"The ISO 3166 alpha-2 code of the sender's country."
	senderCode: String
}

"A term of one of the lists that classify RASFF notifications. Its id is what the filters of rasffNotifications take."
type RasffTerm {
	"The id of the term."
	id: ID!
	"The term in English, for example pet food."
	description: String!
}

"A country that RASFF notifications name as the origin or a destination of a product."
type RasffCountry {
	"The id that the originCountryIds and distributionCountryIds filters take."
	id: ID!
	"The English name of the country."
	name: String!
	"The ISO 3166 alpha-2 code, for example BE."
	code: String
}

"""
A member of the RASFF network, which can send notifications: an EU country, another country of the European
Economic Area, Switzerland, or the European Commission.
"""
type RasffMember {
	"The id that the notifyingMemberIds filter takes."
	id: ID!
	"The English name of the member."
	name: String!
	"The ISO 3166 alpha-2 code, or EU for the European Commission."
	code: String
}

"A country as a RASFF notification names it."
type RasffCountryRef {
	"The English name of the country."
	name: String
	"The ISO 3166 alpha-2 code of the country."
	code: String
}

"An animal species that veterinary medicines can be authorised for in Belgium."
type FamhpTargetSpecies {
	"The identifier in the FAMHP database."
	id: ID!
	"A short code, for example Ca for the dog. Species added later have their name as their code."
	code: String
	"The English name, for example Dog."
	name: String!
}

"A type of authorisation of a medicine in Belgium, for example Marketing authorisation."
type FamhpAuthorisationType {
	"The identifier in the FAMHP database."
	id: ID!
	"A short code, for example MA."
	code: String
	"The English name."
	name: String!
}

"A legal basis of an application for a medicine in Belgium, for example an article of Regulation (EU) 2019/6 on veterinary medicines."
type FamhpLegalBasis {
	"The identifier in the FAMHP database."
	id: ID!
	"The English name."
	name: String!
	"Whether the legal basis applies to medicines for humans, for animals, or both."
	usage: [FamhpUsage!]!
}

"How a medicine may be supplied in Belgium, for example on medical prescription."
type FamhpDeliveryMode {
	"The identifier in the FAMHP database."
	id: ID!
	"The English name."
	name: String!
}

"A type of document that the FAMHP medicines database holds for a medicine, such as the leaflet."
type FamhpDocumentType {
	"The identifier in the FAMHP database."
	id: ID!
	"A short code, for example skp for the summary of product characteristics."
	code: String
	"The English name, for example Leaflet or SPC."
	name: String!
	"Whether documents of this type exist for medicines for humans, for animals, or both."
	usage: [FamhpUsage!]!
	"Whether the documents hold risk minimisation material (RMA)."
	riskMinimisationMaterial: Boolean!
	"The position in the database's own order, starting at 1."
	position: Int!
}

"Whether an entry of the FAMHP database applies to medicines for humans or for animals."
enum FamhpUsage {
	HUMAN
	VETERINARY
}

"""
A price series of the EU's harmonised index of consumer prices (HICP), from Eurostat: one pet category in one
country, with one observation per month or per year.
"""
type EurostatSeries {
	"The code of the Eurostat dataset, for example prc_hicp_minr."
	dataset: String!
	"The title of the dataset."
	title: String
	"The price category, for example Pets and pet products (D). The letters say whether the category holds durable goods (D), non-durable goods (ND) or services (S)."
	category: String
	"The code of the country or group of countries, for example BE."
	country: String!
	"The name of the country, for example Belgium, or null when Eurostat does not know the code."
	countryName: String
	"What the values measure, for example Index, 2025=100 or Annual rate of change."
	unit: String
	"The day Eurostat last updated the dataset."
	lastUpdate: Date
	"The observations, oldest first. The list is empty when Eurostat lacks data for the country."
	observations: [EurostatObservation!]!
}

"One observation of a Eurostat price series."
type EurostatObservation {
	"The month as YYYY-MM, or the year as YYYY."
	period: String!
	"The value, or null when Eurostat has not published it."
	value: Float
	"Eurostat's flag of the value, for example e for an estimate or p for a provisional value."
	flag: String
}

"The pet categories of the harmonised index of consumer prices."
enum EurostatPetCategory {
	"Pets, and products for pets and other household animals."
	PETS_AND_PET_PRODUCTS
	"The animals themselves."
	PETS
	"Products for pets and other household animals, such as food and litter."
	PET_PRODUCTS
	"Veterinary and other services for pets, such as grooming and boarding."
	VETERINARY_SERVICES
}

"""
The filters of a RASFF notification search. Each filter is optional, and a notification must match every filter given.
An id filter takes the ids that the rasff lists return, and matches a notification that has any of them.
"""
input RasffNotificationFilter {
	"Text that the subject contains, for example salmonella."
	subject: String
	"The reference of one notification, for example 2026.8625."
	reference: String
	"Only notifications validated on or after this day."
	validatedFrom: Date
	"Only notifications validated on or before this day."
	validatedTo: Date
	"Product categories, as rasffProductCategories lists them. Pet food is one of them."
	productCategoryIds: [ID!]
	"Product types, as rasffProductTypes lists them."
	productTypeIds: [ID!]
	"Hazard categories, as rasffHazardCategories lists them."
	hazardCategoryIds: [ID!]
	"Risk decisions, as rasffRiskDecisions lists them."
	riskDecisionIds: [ID!]
	"Classifications, as rasffNotificationClassifications lists them."
	classificationIds: [ID!]
	"What led to the notification, as rasffNotificationBases lists it."
	basisIds: [ID!]
	"Measures taken, as rasffActionsTaken lists them."
	actionTakenIds: [ID!]
	"Statuses, as rasffNotificationStatuses lists them."
	statusIds: [ID!]
	"Members that sent the notification, as rasffNetworkMembers lists them."
	notifyingMemberIds: [ID!]
	"Countries the product came from, as rasffCountries lists them."
	originCountryIds: [ID!]
	"Countries the product was distributed to, as rasffCountries lists them."
	distributionCountryIds: [ID!]
}

# The types of the GBIF fields, generated from GBIF's OpenAPI documents.

"A language that GBIF knows, with its codes."
type GbifLanguage {
	"The locale of the language, for example nl-BE."
	locale: String
	"The ISO 639-1 code of the language, for example nl."
	iso2LetterCode: String
	"The ISO 639-2 code of the language, for example nld."
	iso3LetterCode: String
	"The English name of the language, for example Dutch."
	name: String
}

"""
A scientific name split into its parts by GBIF's name parser, for example the genus Canis, the specific epithet
lupus and the authorship Linnaeus, 1758.
"""
type GbifParsedName {
	"The key for this parsed name object."
	key: Int
	"The exact verbatim, full scientific name as given before parsing."
	scientificName: String
	"A coarse classification of names helping to deal with different syntactical name string structures."
	type: String
	"The genus part of a bi/trinomial or the monomial in case of names of higher ranks."
	genusOrAbove: String
	"""
	The infrageneric part of a name, often given in parentheses between genus and species epithet, e.g. for a
	subgenus
	"""
	infraGeneric: String
	"The specific epithet of the name"
	specificEpithet: String
	"The infraspecific part of a name."
	infraSpecificEpithet: String
	"""
	The cultivar, cultivar group or grex part of a cultivated plant name.
	If given the name should be of type CULTIVAR
	"""
	cultivarEpithet: String
	"""
	The strain or isolate name. Usually a capital collection code string followed by an accession number.
	See List of culture collection codes. If given the name should be of type STRAIN.
	"""
	strain: String
	"""
	For hybrid names notho indicates which part of the name is considered a hybrid, i.e. genus, species or
	infraspecific epithet.
	"""
	notho: String
	"The original author of this name, e.g. basionym or recombination author."
	authorship: String
	"The year of publication as given in the authorship."
	year: String
	"The authorship of the original name, i.e. basionym, given in brackets."
	bracketAuthorship: String
	"The code relevant year of publication of the original name, i.e. basionym, given in brackets."
	bracketYear: String
	"""
	Taxon concept references as part of the name, e.g. “MSW2006” for *Gorilla gorilla* (Savage, 1847) sec. MSW2005
	"""
	sensu: String
	"""
	A flag indicating if a name could not be parsed at all.
	If false, only the scientific name, rank and potentially the name type is given.
	"""
	parsed: Boolean
	"""
	The GBIF name parser cannot always parse the entire name.
	This is often the case when taxonomic, nomenclatural or identification notes are added to the end of the name.
	In such cases when the name was only partially parsed (NameUsageIssue.PARTIALLY_PARSABLE) this flag should be
	true.
	If the name was not parsed at all this will be false.
	"""
	parsedPartially: Boolean
	"Any nomenclatoral remarks given in this name, e.g. nom. illeg."
	nomStatus: String
	"Any further remarks found."
	remarks: String
	"""
	The canonical name *sensu strictu* with nothing else but three name parts at most (genus, species,
	infraspecific).
	No rank or hybrid markers and no authorship, cultivar or strain information.
	Infrageneric names are represented without a leading genus.
	Unicode characters are replaced by their matching ASCII characters.
	"""
	canonicalName: String
	"""
	The code-compliant, canonical name with three name parts at max (genus, species, infraspecific), a rank marker
	for infraspecific names and cultivar or strain epithets. The canonical name can be a 1, 2 or 3 parted name, but
	does not include any informal notes or authorships. Notho taxa will have the hybrid marker.
	Unicode characters will be replaced by their matching ASCII characters.
	"""
	canonicalNameWithMarker: String
	"""
	The code-compliant, canonical name with rank and hybrid marker, authorship and cultivar or strain name included.
	Informal or nomenclatoral notes, concept references, subgenus and non-terminal authorships are removed.
	"""
	canonicalNameComplete: String
	"The taxonomic rank of the name."
	rankMarker: String
}

"A page of name usages, as GBIF answers it."
type GbifNameUsagePage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifNameUsage]
}

"""
A name usage: a scientific name as one checklist uses it, with its rank, its taxonomic status and its
classification. The GBIF backbone taxonomy is the checklist that GBIF matches every occurrence to.
"""
type GbifNameUsage {
	"The name usage key that uniquely identifies this name usage."
	key: Int
	"""
	The taxon key of the matching backbone name usage.
	If this is equal to key, this name usage is a backbone name usage.
	"""
	nubKey: Int
	"""
	The key for retrieving a parsed name object.
	*You are more likely to need the key or nubKey properties*
	"""
	nameKey: Int
	"""
	The original taxonID of the name usage as found in the source.
	For backbone taxa and name usages with an origin different to SOURCE this is null.
	"""
	taxonID: String
	"""
	The key of the name usage from which this backbone taxon derives.
	For backbone taxa the source taxon key refers to the original name usage that was used during backbone building
	and is the primary reason that this taxon exists in the backbone.
	All backbone name usages are built from several underlying checklist usages, but these are sorted by priority
	and the usage key for the highest priority one becomes the sourceTaxonKey for a backbone usage.
	Some backbone usages do not have any source record at all; for example if there is a subspecies found, but no
	matching parent species, the missing species will be created nevertheless and has no primary source.
	"""
	sourceTaxonKey: Int
	"Kingdom."
	kingdom: String
	"Phylum."
	phylum: String
	"Order."
	order: String
	"Family."
	family: String
	"Genus."
	genus: String
	"Subgenus."
	subgenus: String
	"Species."
	species: String
	"Name usage key of the kingdom."
	kingdomKey: Int
	"Name usage key of the phylum."
	phylumKey: Int
	"Name usage key of the class."
	classKey: Int
	"Name usage key of the order."
	orderKey: Int
	"Name usage key of the family."
	familyKey: Int
	"Name usage key of the genus."
	genusKey: Int
	"Name usage key of the subgenus."
	subgenusKey: Int
	"Name usage key of the species."
	speciesKey: Int
	"""
	The checklist that “hosts” this name usage.
	For a backbone name usage, this will be d7dddbf4-2cf0-4f39-9b2a-bb099caae36c.
	"""
	datasetKey: ID
	"The optional sub-dataset key for this usage."
	constituentKey: ID
	"The name usage key of the immediate parent. Null for the highest taxonomic level."
	parentKey: Int
	"The scientific name of the parent."
	parent: String
	"""
	The primary name usage key for a *pro parte* synonym.
	Synonyms with multiple accepted names are grouped by a single, primary name usage key.
	"""
	proParteKey: Int
	"The name usage key of the accepted name."
	acceptedKey: Int
	"The scientific name of the accepted name."
	accepted: String
	"The name usage key of the basionym."
	basionymKey: Int
	"The scientific name of the basionym."
	basionym: String
	"""
	The scientific name, with date and authorship information if available.
	Examples: *Coleoptera* (order), *Vespertilionidae* (family), *Manis* (genus), *Ctenomys sociabilis* (genus +
	specificEpithet), *Ambystoma tigrinum diaboli* (zoology, genus + specific name + infraspecific name) *Quercus
	agrifolia* var. *oxyadenia* (Torr.) (botany, genus + specific epithet + infraspecific epithet + authorship)
	"""
	scientificName: String
	"The canonical name; the name without authorship or references."
	canonicalName: String
	"A common or vernacular name for this usage."
	vernacularName: String
	"The authorship for the scientific name."
	authorship: String
	"The type of name string classified by Checklistbank."
	nameType: String
	"The rank for this usage."
	rank: String
	"""
	The name usage origin.
	The origin of this name usage record, the reason it exists.
	In most cases this is because the record existed explicitly in the checklist sources, but some usages are
	created *de novo* because the exist implicitly in the data.
	"""
	origin: String
	"""
	The taxonomic status of the name usage.
	Can be null, but for all synonyms with an accepted name usage it is guaranteed to exist.
	"""
	taxonomicStatus: String
	"The nomenclatural statuses of this name usage."
	nomenclaturalStatus: [String]
	"Remarks on the name usage."
	remarks: String
	"Original publication for this name usage."
	publishedIn: String
	"""
	The taxon concept reference.
	This is usually a reference to some publication or an author and year.
	The Darwin Core taxonAccordingTo reference is usually appended to the scientific name to further qualify the
	concept with “sensu” or “sec.” being used for concatenation; for example “_Acer nigrum_ sec. Gleason Cronquist
	1991”.
	In the case of backbone taxa, this refers to the primary checklist in which the name was found.
	"""
	accordingTo: String
	"A total count of all accepted taxonomic elements under this usage."
	numDescendants: Int
	"A URI link or reference to the source of the record, the record's “homepage”."
	references: String
	"""
	The interpreted dc:modified from the verbatim source data, ideally indicating when a record was last modified in
	the source.
	"""
	modified: String
	"""
	The date this record was deleted.
	*Only backbone name usages are soft-deleted.*
	"""
	deleted: String
	"The date this record was last crawled (downloaded from the source) during Checklistbank indexing."
	lastCrawled: String
	"The date this record was last interpreted during indexing. This includes matching to the backbone."
	lastInterpreted: String
	"Data quality issues found during Checklistbank interpretation."
	issues: [String]
	"Class."
	class: String
}

"A page of vernacular names, as GBIF answers it."
type GbifVernacularNamePage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifVernacularName]
}

"A common name of a taxon in one language, for example dog in English or hond in Dutch."
type GbifVernacularName {
	"The name usage “taxon“ key to which this vernacular name belongs."
	taxonKey: Int
	"A common or vernacular name."
	vernacularName: String
	"The language (from ISO 639-1) of the vernacular name."
	language: String
	"""
	The age class or life stage of the species for which the vernacular name applies.
	For example, a juvenile *Anser anser* is called a “gosling“.
	"""
	lifeStage: String
	"""
	The sex of the taxon for which the vernacular name applies when the name is limited to a specific sex of a
	species.
	For example, “goose“ can refer to either male or female *Anser*, but only males may be called “gander”.
	"""
	sex: String
	"The country or area in which the vernacular name is used."
	country: String
	"The area where the vernacular name is used."
	area: String
	"Bibliographic citation referencing a source where the vernacular name refers to the cited species."
	source: String
	"The name usage key of the taxon in the checklist including this vernacular name."
	sourceTaxonKey: Int
	"""
	This term is true if the source citing the use of this vernacular name indicates the usage has some preference
	or specific standing over other possible vernacular names used for the species.
	"""
	preferred: Boolean
	"True if the vernacular name refers to a plural form of the name."
	plural: Boolean
}

"A page of species profiles, as GBIF answers it."
type GbifSpeciesProfilePage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifSpeciesProfile]
}

"""
Facts about the life of a species from one checklist, such as its habitat, its size and whether it is extinct.
"""
type GbifSpeciesProfile {
	"The name usage “taxon“ key to which this species profile belongs."
	taxonKey: Int
	"The geological time a currently extinct organism is known to have lived."
	livingPeriod: String
	"""
	A term describing the growth/lifeform of an organism.
	See Life Form vocabulary.
	"""
	lifeForm: String
	"""
	Comma-separated list of major habitat classifications as defined by the IUCN in which a species is known to
	exist.
	See Habitats vocabulary.
	"""
	habitat: String
	"""
	A Boolean flag indicating whether the taxon is a marine organism, i.e. can be found in/above sea water.
	"""
	marine: Boolean
	"Flag indicating whether the taxon is a freshwater organism."
	freshwater: Boolean
	"""
	A Boolean flag indicating the taxon is a terrestrial organism, i.e. occurs on land as opposed to the sea.
	"""
	terrestrial: Boolean
	"Flag indicating an extinct organism."
	extinct: Boolean
	"Flag indicating a hybrid organism."
	hybrid: Boolean
	"Maximum observed age of an organism given as number of days."
	ageInDays: Int
	"""
	Maximum observed size of an organism in millimetres.
	Can be either height, length or width, whichever is greater.
	"""
	sizeInMillimeter: Int
	"Maximum observed weight of an organism in grams."
	massInGram: Int
	"Bibliographic citation referencing a source for the species profile."
	source: String
	"The name usage key of the taxon in the checklist including this species profile."
	sourceTaxonKey: Int
}

"A page of references, as GBIF answers it."
type GbifReferencePage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifReference]
}

"A publication that a checklist cites for a name usage."
type GbifReference {
	"The name usage “taxon“ key to which this species profile belongs."
	taxonKey: Int
	"A text string referring to an un-parsed bibliographic citation."
	citation: String
	"The reference link."
	link: String
	"The pure DOI for the publication without potential http resolver or URI prefix."
	doi: String
	"Used to assign a bibliographic reference to list of taxonomic or nomenclatural categories."
	type: String
	"Annotation of taxon-specific information related to the referenced publication."
	remarks: String
	"Bibliographic citation referencing a source for the reference."
	source: String
	"The name usage key of the taxon in the checklist including this reference."
	sourceTaxonKey: Int
	"Title of book or article."
	title: String
	"The author or authors of the referenced work."
	author: String
	"Date of publication."
	date: String
}

"The number of taxa below a name usage, by rank, and its number of synonyms."
type GbifNameUsageMetrics {
	"The name usage key that uniquely identifies this name usage."
	key: Int
	"""
	Returns the number of phyla that are below this taxon. Typically, this would mean this usage is of something
	above the “phylum” taxonomic level.
	"""
	numPhylum: Int
	"""
	Returns the number of classes that are below this taxon. Typically, this would mean this usage is of something
	above the “class” taxonomic level.
	"""
	numClass: Int
	"""
	Returns the number of orders that are below this taxon. Typically, this would mean this usage is of something
	above the “order” taxonomic level.
	"""
	numOrder: Int
	"""
	Returns the number of families that are below this taxon. Typically, this would mean this usage is of something
	above the “family” taxonomic level.
	"""
	numFamily: Int
	"""
	Returns the number of genus that are below this taxon. Typically, this would mean this usage is of something
	above the “genus” taxonomic level.
	"""
	numGenus: Int
	"""
	Returns the number of distinct subgenera that are below this taxon. Typically, this would mean this usage is of
	something above the “subgenus” taxonomic level.
	"""
	numSubgenus: Int
	"""
	Returns the number of species that are below this taxon. Typically, this would mean this usage is of something
	above the “species” taxonomic level.
	"""
	numSpecies: Int
	"""
	Returns the number of direct taxonomic elements under this usage. “Direct” means that children should have this
	usageKey as their parentKey.
	"""
	numChildren: Int
	"The number of all accepted taxonomic elements under this usage."
	numDescendants: Int
	"Returns the number of related synonyms this usage possses."
	numSynonyms: Int
}

"A page of media items, as GBIF answers it."
type GbifNameUsageMediaObjectPage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifNameUsageMediaObject]
}

"An image, a sound or a video of a taxon, from a checklist."
type GbifNameUsageMediaObject {
	"The kind of media object."
	type: String
	"The format the image is exposed in."
	format: String
	"An HTML webpage that shows the image or its metadata."
	references: String
	"The media item title."
	title: String
	"A longer description for this media item."
	description: String
	"Where the media item comes from."
	source: String
	"A class or description for whom the image is intended or useful."
	audience: String
	"The date and time this media item was created."
	created: String
	"The person that created the media item."
	creator: String
	"Any contributor in addition to the creator that helped in recording the media item."
	contributor: String
	"An entity responsible for making the media item available."
	publisher: String
	"Licence for this media item."
	license: String
	"A person or organization owning or managing rights over the media item."
	rightsHolder: String
	"The name usage “taxon“ key to which this species profile belongs."
	taxonKey: Int
	"The name usage key of the taxon in the checklist including this media object."
	sourceTaxonKey: Int
	"The public URL that identifies and locates the media item."
	identifier: String
}

"The category of a species on the IUCN Red List of Threatened Species, for example LEAST_CONCERN."
type GbifIucnRedListCategory {
	"The taxonomic threat status as given in our ThreatStatus enum."
	category: String
	"The name usage “taxon“ key to which this Red List category applies."
	usageKey: Int
	"The scientific name."
	scientificName: String
	"The taxonomic status of the name."
	taxonomicStatus: String
	"The accepted name, if the name is a synonym."
	acceptedName: String
	"The accepted name's usage key, if the name is a synonym."
	acceptedUsageKey: Int
	"The original IUCN identifier used for the name usage."
	iucnTaxonID: String
	"The code for the taxonomic threat status as given in our ThreatStatus enum."
	code: String
}

"A page of name usage identifiers, as GBIF answers it."
type GbifNameUsageIdentifierPage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifNameUsageIdentifier]
}

"An identifier of a name usage in another system, such as a URL or an LSID."
type GbifNameUsageIdentifier {
	"""
	Other known identifier used for the same taxon. Can be a URL pointing to a webpage, an XML or RDF document, a
	DOI UUID or any other identifier.
	"""
	identifier: String
	"The optional title of an identifier, mostly for linking."
	title: String
	"Type of identifier."
	type: String
	"An HTTP link for an identifier, if a suitable, known resolver exists for the identifier type."
	identifierLink: String
}

"A page of distributions, as GBIF answers it."
type GbifDistributionPage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifDistribution]
}

"""
Where a taxon lives according to one checklist, with its status there, for example native or introduced.
"""
type GbifDistribution {
	"The name usage “taxon“ key to which this species profile belongs."
	taxonKey: Int
	"A code for the named area this distributon record is about."
	locationId: String
	"The verbatim name of the area this distribution record is about."
	locality: String
	"The country"
	country: String
	"""
	Term describing the occurrence status of the organism in the given area based on how frequent the species
	occurs.
	"""
	status: String
	"The distribution information pertains solely to a specific life stage of the taxon."
	lifeStage: String
	"""
	Relevant temporal context for this entire distribution record including all properties, preferably given as a
	year range or single year on which the distribution record is valid.
	For the same area and taxon there could therefore be several records with different temporal context, e.g. in
	5-year intervals for invasive species.
	"""
	temporal: String
	"Threat status of a species as defined by IUCN."
	threatStatus: String
	"Term describing whether the organism occurs natively, is introduced or cultivated."
	establishmentMeans: String
	"""
	The CITES (Convention on International Trade in Endangered Species of Wild Fauna and Flora) Appendix number
	under which the taxon is listed.
	It is possible to have different appendix numbers for different areas, but “global” as an area is also valid.
	"""
	appendixCites: String
	"Bibliographic citation referencing a source for the distribution."
	source: String
	"The name usage key of the taxon in the checklist including this distribution."
	sourceTaxonKey: Int
	"""
	Seasonal temporal subcontext within the eventDate context. Useful for migratory species.
	The earliest ordinal day of the year on which the distribution record is valid. Numbering starts with 1 for 1
	January and ends with 365 or 366 for 31 December.
	"""
	startDayOfYear: Int
	"""
	Seasonal temporal subcontext within the eventDate context. The latest ordinal day of the year on which the
	distribution record is valid.
	"""
	endDayOfYear: Int
	"Additional notes on the distribution."
	remarks: String
}

"A page of descriptions, as GBIF answers it."
type GbifDescriptionPage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifDescription]
}

"A text that describes a taxon, such as its morphology or its ecology, from one checklist."
type GbifDescription {
	"""
	A unique GBIF identifier for the description.
	This key is used in the table of contents to retrieve the detailed description.
	"""
	key: Int
	"The name usage “taxon“ key to which this species profile belongs."
	taxonKey: Int
	"""
	The type used to categorize paragraphs of a taxon description.
	See the Description Type vocabulary.
	"""
	type: String
	"ISO 639-1 language code used for the description."
	language: String
	"""
	Any descriptive, free text matching the category given as dc:type.
	The text should be either plain text or HTML.
	"""
	description: String
	"Bibliographic citation referencing a source for the description."
	source: String
	"The name usage key of the taxon in the checklist including this description."
	sourceTaxonKey: Int
	"The author(s) of the textual information provided for a description."
	creator: String
	"""
	An entity responsible for making contributions to the textual information provided for a description.
	"""
	contributor: String
	"Official permission to do something with the resource."
	license: String
}

"A child taxon of a name usage with the number of taxa below it."
type GbifUsageCount {
	"The key that identifies the child taxon in GBIF."
	key: Int
	"The scientific name of the child taxon."
	name: String
	"The rank of the child taxon."
	rank: String
	"The number of taxa below the child taxon."
	size: Int
}


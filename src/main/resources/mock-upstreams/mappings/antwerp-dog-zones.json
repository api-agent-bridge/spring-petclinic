{
  "mappings": [
    {
      "name": "Antwerp geocoder: Groenendaallaan 394, Antwerpen",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPath": "/antwerp/arcgissql/services/LOC_CRAB/GeocodeServer",
        "bodyPatterns": [
          {
            "matchesXPath": "//PropertyArray[PropertySetProperty[Key='Street' and Value='Groenendaallaan'] and PropertySetProperty[Key='House' and Value='394'] and PropertySetProperty[Key='City' and Value='Antwerpen']]"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "text/xml; charset=UTF-8"
        },
        "bodyFileName": "antwerp/geocode-groenendaallaan-394.xml"
      },
      "metadata": {
        "description": "The geocoder finds the address and answers with a point in Belgian Lambert 72"
      }
    },
    {
      "name": "Antwerp geocoder: any other address",

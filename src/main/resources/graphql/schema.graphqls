"A name usage match returned by the webservices. Includes higher taxonomy and diagnostics"
type GbifNameUsageMatch {
	"A name with an identifier and a taxonomic rank"
	usage: GbifUsage
	"A name with an identifier and a taxonomic rank"
	acceptedUsage: GbifUsage
	"The classification of the accepted name usage."
	classification: [GbifRankedName]
	"Diagnostics for a name match including the type of match and confidence level"
	diagnostics: GbifDiagnostics
	"Status information from external sources such as IUCN Red List"
	additionalStatus: [GbifStatus]
	"If the matched usage is a synonym"

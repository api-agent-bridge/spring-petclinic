	creator: String
	"The email addresses that GBIF notifies when the download is ready."
	notificationAddresses: [String]
	"Whether to send a notification email when the download finishes."
	sendNotification: Boolean
	"The data format of the download."
	format: String
	"""
	A user-specified description of the download, such as the intended purpose or a tag for later reference.
	"""
	description: String
	"The key of the checklist that the download matches names in."
	checklistKey: String
}

"The files and the columns of a Darwin Core Archive download of occurrences."
type GbifDwcaDownloadDescription {
	"The columns of the file with the values as the datasets wrote them."
	verbatim: GbifDownloadTable
	"The columns of the file of images and other media."
	multimedia: GbifDownloadTable
	"The columns of the file with the values as GBIF interpreted them."
	interpreted: GbifDownloadTable
	"The extensions that the download can hold, such as measurements."
	verbatimExtensions: [String]
}

"The columns of a file in an occurrence download."
type GbifDownloadTable {
	"The columns of the file."
	fields: [GbifField]
}

"Field description of file or download table."
type GbifField {
	"The column name in download files."
	name: String
	"The data type."
	type: String
	"A pattern showing the format of the field data."
	typeFormat: String
	"The character used to delimit array values."
	delimiter: String
	"The URI for the term (e.g. Darwin Core term) for the field."
	term: String
	"Whether the field may be null (empty). If false it will be present on all records."
	nullable: Boolean
}

"A term that occurrences use, such as dwc:scientificName from the Darwin Core standard."
type GbifOccurrenceTerm {
	"The short name of the term, for example scientificName."
	simpleName: String
	"""
	The full URI of the term: the namespace of its standard followed by its short name, such as scientificName in
	the Darwin Core namespace rs.tdwg.org/dwc/terms/.
	"""
	qualifiedName: String
	"The group of the term, for example Occurrence or Taxon."
	group: String
	"The standard that the term comes from, for example DwcTerm for Darwin Core."
	source: String
}

"""
An occurrence download: a file of occurrences that a GBIF user requested, with its DOI for citation.
"""
type GbifDownload {
	"""
	The GBIF key assigned to the download.
	Note that citations should instead use the download DOI.
	"""
	key: String
	"The primary Digital Object Identifier (DOI) for this download."
	doi: String
	"""
	The licence applied to the download. This is calculated as the most restrictive licence of any of the data
	included in the download, other data may be less restrictive.
	"""
	license: String
	"The filter used to request this download."
	request: GbifDownloadRequest
	"The time the download request was submitted."
	created: String
	"The time the download was last modified."
	modified: String
	"A time after which the download may be deleted."
	eraseAfter: String
	"""
	The most recent time when the creator of the download was notified the download is due to be deleted.
	"""
	erasureNotification: String
	"""
	The status of the download.
	* PREPARING: the download is in a queue, waiting for other downloads to complete
	* RUNNING: the download is being processed
	* SUCCEEDED: the download has completed and the file is ready to be downloaded
	* CANCELLED: the download was cancelled by the user
	* KILLED: the download was killed by the download engine
	* FAILED: the download failed
	* SUSPENDED: the download was paused and its execution will be resumed later
	* FILE_ERASED: the download was successful, but the download file has since been deleted.
	"""
	status: String
	"A link to download the data, if the status is SUCCEEDED."
	downloadLink: String
	"The size, in bytes, of the download data."
	size: Long
	"The total number of occurrence records included in the download."
	totalRecords: Long
	"The total number of datasets from which occurrence records were drawn."
	numberDatasets: Long
	"The total number of organizations from which occurrence records were drawn."
	numberOrganizations: Long
	"The total number of publishing countries from which occurrence records were drawn."
	numberPublishingCountries: Long
}

"A page of dataset occurrence download usages, as GBIF answers it."
type GbifDatasetOccurrenceDownloadUsagePage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifDatasetOccurrenceDownloadUsage]
}

"A dataset in an occurrence download, with the number of its records in the download."
type GbifDatasetOccurrenceDownloadUsage {
	"""
	The GBIF key assigned to the download.
	Note that citations should instead use the download DOI.
	"""
	downloadKey: String
	"The GBIF dataset key of the dataset."
	datasetKey: ID
	"The title of the dataset, at the time the download was created."
	datasetTitle: String
	"The primary Digital Object Identifier (DOI) for the dataset."
	datasetDOI: String
	"The citation for the dataset, at the time the download was created."
	datasetCitation: String
	"The number of records from this dataset included in the download."
	numberRecords: Long
	"Further information about the download."
	download: GbifDownload
	"The publishing country code of the publishing organization of the dataset."
	publishingCountryCode: String
}

"A page of download statisticses, as GBIF answers it."
type GbifDownloadStatisticsPage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifDownloadStatistics]
}

"The number of downloads of a dataset in one month, and the number of its records in them."
type GbifDownloadStatistics {
	"The GBIF dataset key for the dataset."
	datasetKey: ID
	"""
	The total number of records in downloads from the given dataset. Records present in multiple downloads will be
	counted more than once.
	"""
	totalRecords: Long
	"The number of downloads including at least one record from the dataset."
	numberDownloads: Long
	"The year."
	year: Int
	"The month, from 1 to 12."
	month: Int
}

"An administrative area of the GADM database, such as a country, a province or a municipality."
type GbifGadmRegion {
	"The GADM identifier of the area, for example BEL.1_1."
	id: String
	"The name of the area, for example Antwerpen."
	name: String
	"The level of the area: 0 for a country, 1 for its first subdivision, and so on."
	gadmLevel: Int
	"Other names of the area."
	variantName: [String]
	"The name of the area in a script other than Latin."
	nonLatinName: [String]
	"The kind of the area in the local language, for example Provincie."
	type: [String]
	"The kind of the area in English, for example Province."
	englishType: [String]
	"The areas that contain this one, from the country down."
	higherRegions: [GbifGadmHigherRegion]
}

"An administrative area that contains another one in the GADM database."
type GbifGadmHigherRegion {
	"The GADM identifier of the area."
	id: String
	"The name of the area."
	name: String
}

"A page of regions, as GBIF answers it."
type GbifGadmRegionPage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifGadmRegion]
}

"The combinations of filters that the occurrence count accepts."
type GbifOccurrenceCountSchema {
	"The filters of one combination."
	dimensions: [GbifCountDimension]
}

"A filter that the occurrence count accepts."
type GbifCountDimension {
	"The name of the filter."
	key: String
}

"A page of collections, as GBIF answers it."
type GbifCollectionViewPage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifCollectionView]
}

"""
A collection of natural history specimens in GRSciColl, GBIF's registry of scientific collections, with the name
and code of the institution that holds it.
"""
type GbifCollectionView {
	"Unique GBIF key for the collection."
	key: ID
	"""
	Code of the collection ,  identifies a collection at the owner's location.
	*(NB Not required for updates.)*
	"""
	code: String
	"""
	Descriptive name of the collection.
	*(NB Not required for updates.)*
	"""
	name: String
	"Description or summary of the contents of the collection."
	description: String
	"Content type of the elements found in the collection."
	contentTypes: [String]
	"Whether the collection is active/maintained."
	active: Boolean
	"Whether this collection belongs to an individual."
	personalCollection: Boolean
	"A Digital Object Identifier for the collection."
	doi: String
	"Email addresses associated with the collection."
	email: [String]
	"Telephone numbers associated with the collection."
	phone: [String]
	"The collection's WWW homepage."
	homepage: String
	"URLs for interactive catalogues of the collection."
	catalogUrls: [String]
	"URLs for machine-readable APIs for the collection catalogue."
	apiUrls: [String]
	"The preservation mechanisms used for this collection."
	preservationTypes: [String]
	"How the collection was added or joined."
	accessionStatus: String
	"The key of the institution owning or hosting the collection."
	institutionKey: ID
	"The postal address of the collection."
	mailingAddress: GbifAddress
	"The address of the location of the collection."
	address: GbifAddress
	"The GBIF username of the creator of the collection entity in the GBIF registry."
	createdBy: String
	"The GBIF username of the last user to modify the collection entity in the GBIF registry."
	modifiedBy: String
	"Timestamp of when the collection entity was created in the GBIF registry."
	created: String
	"Timestamp of when the collection entity was modified in the GBIF registry."
	modified: String
	"""
	If present, the collection was deleted at this time. It is possible for it to be restored in the future.
	"""
	deleted: String
	"A list of tags associated with this collection."
	tags: [GbifTag]
	"A list of identifiers associated with this collection."
	identifiers: [GbifRegistryIdentifier]
	"A list of contact people for this collection."
	contactPersons: [GbifContact]
	"The number of specimens contained in this collection."
	numberSpecimens: Int
	"A list of machine tags associated with this collection."
	machineTags: [GbifMachineTag]
	"The taxonomic coverage of this collection."
	taxonomicCoverage: String
	"The geographic coverage of this collection."
	geographicCoverage: String
	"Notes on the collection."
	notes: String
	"Other collections incorporated into this collection."
	incorporatedCollections: [String]
	"Alternative codes for this collection."
	alternativeCodes: [GbifAlternativeCode]
	"A list of comments associated with this collection."
	comments: [GbifComment]
	"Mapping of a GRSciColl collection to occurrence records"
	occurrenceMappings: [GbifOccurrenceMapping]
	"A collection record that replaces this collection."
	replacedBy: ID
	"The primary source of this collection record."
	masterSource: String
	"""
	Information to assist the synchronization of the master source record with the record in the GBIF registry.
	"""
	masterSourceMetadata: GbifMasterSourceMetadata
	"An organizational department managing the collection."
	department: String
	"An organizational division managing the collection."
	division: String
	"Whether the collection is shown on the NHC portal."
	displayOnNHCPortal: Boolean
	"An estimate of the number of occurrences linked to the institution."
	occurrenceCount: Int
	"An estimate of the number of type specimens linked to the institution."
	typeSpecimenCount: Int
	"""
	URI to the image to be featured on the collection page, this image should be associated with a license.
	"""
	featuredImageUrl: String
	"The license associated with the image to be featured on the collection page."
	featuredImageLicense: String
	"""
	Temporal scope or focus of the collection. This free text field can be used to describe both the collection date
	ranges as well as the geological time group(s) of the collection objects in the context of paleontological
	collections.
	"""
	temporalCoverage: String
	"""
	Information about ownership, attribution, etc. of the featured image. This value with be used to generate a
	suggested citation of the image.
	"""
	featuredImageAttribution: String
	"The name of the institution that holds the collection."
	institutionName: String
	"The code of the institution that holds the collection."
	institutionCode: String
}


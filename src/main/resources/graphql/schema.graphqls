	"""
	Converts a plain search query into a download predicate.
	Takes a search query used for the ordinary search API and returns a predicate suitable for the download API. In
	many cases, a query from the website can be converted using this method.
	"""
	gbifOccurrenceSearchAsDownloadPredicate(
		"Email notification address."
		notification_address: String
		"Download format."
		format: String!
		"Verbatim extensions to include in a Darwin Core Archive download."
		verbatimExtensions: String
		"The interpreted extensions to include in the download, separated by commas."
		interpretedExtensions: String
		"A description of the download, for the person who requests it."
		description: String
		"A description of the download for software, as JSON text."
		machineDescription: String
		"""
		*Experimental.* The checklist to use that will supply interpreted taxonomic fields. The default is to use the
		GBIF Backbone.download.
		"""
		checklistKey: String
	): GbifDownloadRequest

	"""
	One occurrence, a record of an organism seen or collected at a place and a time, by its key.
	Occurrence by id.
	Retrieve details for a single, interpreted occurrence.
	The returned occurrence includes additional fields, not shown in the response below. They are verbatim fields
	which are not interpreted by GBIF's system, e.g. location. The names are the short Darwin Core Term names.
	"""
	gbifOccurrenceById(
		"Integer gbifId for the occurrence."
		gbifId: Long!
	): GbifOccurrence

	"""

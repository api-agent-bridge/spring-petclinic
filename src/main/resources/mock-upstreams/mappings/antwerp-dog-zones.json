    {
      "name": "Antwerp dog zones: unknown map name",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/antwerp/arcgissql/services/P_Portal/portal_publiek1/MapServer",
        "bodyPatterns": [

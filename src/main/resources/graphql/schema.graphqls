"""
A problem or change that GBIF flagged while it interpreted an occurrence, for the occurrence count. It holds the
same values as GbifOccurrenceIssue, except a few newer ones.
"""
enum GbifOccurrenceCountIssue {
	ZERO_COORDINATE
	COORDINATE_OUT_OF_RANGE

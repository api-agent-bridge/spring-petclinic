"""
The kind of type specimen, the specimen that a scientific name is based on, for example HOLOTYPE or PARATYPE.
"""
enum GbifTypeStatus {
	TYPE
	TYPE_SPECIES
	TYPE_GENUS
	ALLOLECTOTYPE
	ALLONEOTYPE
	ALLOTYPE
	COTYPE
	EPITYPE
	EXEPITYPE
	EXHOLOTYPE
	EXISOTYPE
	EXLECTOTYPE
	EXNEOTYPE
	EXPARATYPE
	EXSYNTYPE
	EXTYPE
	HAPANTOTYPE
	HOLOTYPE
	HYPOTYPE
	ICONOTYPE
	ISOLECTOTYPE
	ISONEOTYPE
	ISOPARATYPE
	ISOSYNTYPE
	ISOTYPE
	LECTOTYPE
	NEOTYPE
	NOTATYPE
	ORIGINALMATERIAL
	PARALECTOTYPE
	PARANEOTYPE
	PARATYPE
	PLASTOHOLOTYPE
	PLASTOISOTYPE
	PLASTOLECTOTYPE
	PLASTONEOTYPE
	PLASTOPARATYPE
	PLASTOSYNTYPE
	PLASTOTYPE
	PLESIOTYPE
	SECONDARYTYPE
	SUPPLEMENTARYTYPE
	SYNTYPE
	TOPOTYPE
}

"""
The source that a collection or institution of GRSciColl is synchronised from: a GBIF DATASET, a GBIF
ORGANIZATION, or Index Herbariorum (IH_IRN).
"""
enum GbifCollectionMasterSource {
	DATASET
	ORGANIZATION
	IH_IRN
}

"The kind of an identifier, for example DOI, URL, UUID or LSID."
enum GbifIdentifierType {
	URL
	LSID
	HANDLER
	DOI
	UUID
	FTP
	URI
	UNKNOWN
	GBIF_PORTAL
	GBIF_NODE
	GBIF_PARTICIPANT
	GRSCICOLL_ID
	GRSCICOLL_URI
	IH_IRN
	ROR
	GRID
	CITES
	SYMBIOTA_UUID
	WIKIDATA
	NCBI_BIOCOLLECTION
	ISIL
	CLB_DATASET_KEY
	RNC_COLOMBIA
}

"""
The system that holds the master record of a collection or institution: GRSciColl itself, the GBIF registry, or
Index Herbariorum (IH).
"""
enum GbifMasterSourceType {
	GRSCICOLL
	GBIF_REGISTRY
	IH
}

"""
What collections and institutions are sorted by: NUMBER_SPECIMENS, the number of specimens they hold.
"""
enum GbifCollectionSortField {
	NUMBER_SPECIMENS
}

"""
The type of a dataset: OCCURRENCE (records of organisms), CHECKLIST (a list of names), SAMPLING_EVENT (records
from sampling) or METADATA (a description only).
"""
enum GbifDatasetType {
	OCCURRENCE
	CHECKLIST
	METADATA
	SAMPLING_EVENT
}

"""
The software of an installation, the server that publishes datasets to GBIF, for example IPT_INSTALLATION for
the Integrated Publishing Toolkit.
"""
enum GbifInstallationType {
	IPT_INSTALLATION
	DIGIR_INSTALLATION
	TAPIR_INSTALLATION
	BIOCASE_INSTALLATION
	HTTP_INSTALLATION
	SYMBIOTA_INSTALLATION
	EARTHCAPE_INSTALLATION
	MDT_INSTALLATION
}

"""
The subtype of a dataset, for example TAXONOMIC_AUTHORITY or INVENTORY_REGIONAL for a checklist, and SPECIMEN or
OBSERVATION for occurrences.
"""
enum GbifDatasetSubtype {
	TAXONOMIC_AUTHORITY
	NOMENCLATOR_AUTHORITY
	INVENTORY_THEMATIC
	INVENTORY_REGIONAL
	GLOBAL_SPECIES_DATASET
	DERIVED_FROM_OCCURRENCE
	SPECIMEN
	OBSERVATION
}

"The format of a metadata document of a dataset, for example EML, the Ecological Metadata Language."
enum GbifMetadataType {
	EML
	DC
	DWC_DP
	COL_DP
}

"The status of a suggested change to GRSciColl: PENDING, APPLIED or DISCARDED."
enum GbifSuggestionStatus {
	PENDING
	APPLIED
	DISCARDED
}

"The kind of a suggested change to GRSciColl, for example CREATE or UPDATE."
enum GbifSuggestionType {
	CREATE
	UPDATE
	DELETE
	MERGE
	CONVERSION_TO_COLLECTION
}

"The kind of a publication, for example JOURNAL, BOOK or REPORT."
enum GbifLiteratureType {
	JOURNAL
	BOOK
	GENERIC
	BOOK_SECTION
	CONFERENCE_PROCEEDINGS
	WORKING_PAPER
	REPORT
	WEB_PAGE
	THESIS
	MAGAZINE_ARTICLE
	STATUTE
	PATENT
	NEWSPAPER_ARTICLE
	COMPUTER_PROGRAM
	HEARING
	TELEVISION_BROADCAST
	ENCYCLOPEDIA_ARTICLE
	CASE
	FILM
	BILL
}

"""
How a publication relates to GBIF, for example GBIF_USED when it uses GBIF data or GBIF_CITED when it cites
GBIF.
"""
enum GbifLiteratureRelevance {
	GBIF_USED
	GBIF_CITED
	GBIF_DISCUSSED
	GBIF_PRIMARY
	GBIF_ACKNOWLEDGED
	GBIF_PUBLISHED
	GBIF_AUTHOR
	GBIF_MENTIONED
	GBIF_FUNDED
}

"A topic of a publication, for example CONSERVATION or CLIMATE_CHANGE."
enum GbifLiteratureTopic {
	AGRICULTURE
	BIODIVERSITY_SCIENCE
	BIOGEOGRAPHY
	CITIZEN_SCIENCE
	CLIMATE_CHANGE
	CONSERVATION
	DATA_MANAGEMENT
	DATA_PAPER
	ECOLOGY
	ECOSYSTEM_SERVICES
	EVOLUTION
	FRESHWATER
	HUMAN_HEALTH
	INVASIVES
	MARINE
	PHYLOGENETICS
	SPECIES_DISTRIBUTIONS
	TAXONOMY
}

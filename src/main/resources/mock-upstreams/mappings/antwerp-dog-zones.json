        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "text/xml; charset=UTF-8"
        },
        "bodyFileName": "antwerp/fault-wrong-map-name.xml"
      },
      "metadata": {
        "description": "ArcGIS Server answers a wrong map name with a SOAP fault and HTTP status 200"
      }
    },
    {
      "name": "Antwerp dog zones: the square around Groenendaallaan 394",
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPath": "/antwerp/arcgissql/services/P_Portal/portal_publiek1/MapServer",
        "bodyPatterns": [

	"The dataset title of the joined external ID"
	datasetTitle: String
	"The parent ID of the external identifier"
	parentID: String
	"The scientific name associated with the external identifier"
	scientificName: String
	"The accepted taxon ID of the external identifier"
	acceptedTaxonID: String
	"The rank of the external identifier"
	rank: String
	"The status of the external identifier"
	status: String
	"Recognised variants of this ID"

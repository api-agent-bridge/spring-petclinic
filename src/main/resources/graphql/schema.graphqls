}

"A tag for software on an entity of the GBIF registry, as a namespace, a name and a value."
type GbifMachineTag {
	"Identifier for the machine tag."
	key: Int
	"The namespace for the machine tag."
	namespace: String
	"The name (within the namespace) of the machine tag."
	name: String
	"The value of the machine tag."
	value: String
	"The GBIF username of the creator of the machine tag."
	createdBy: String
	"Timestamp of when the machine tag was created."
	created: String
}

"Another code of a collection or an institution."
type GbifAlternativeCode {
	"The other code."
	code: String
	"Why the entity has this other code."
	description: String
}

"A comment on an entity of the GBIF registry."
type GbifComment {
	"Identifier for the comment"
	key: Int
	"The text of the comment"
	content: String
	"The GBIF username of the creator of the comment"
	createdBy: String
	"The GBIF username of the last user to modify the comment"
	modifiedBy: String
	"Timestamp of when the comment was created"
	created: String
	"Timestamp of when the comment was last modified"
	modified: String
}

"""
A rule that links occurrences to a collection or an institution, by the codes the occurrences carry.
"""
type GbifOccurrenceMapping {
	"The key that identifies the occurrence mapping in GBIF."
	key: Int
	"The code of the collection that the occurrences carry."
	code: String
	"The code of the institution that the occurrences carry."
	parentCode: String
	"The identifier that the occurrences carry."
	identifier: String
	"The key of the dataset, a UUID."
	datasetKey: ID
	"The GBIF account that created the occurrence mapping."
	createdBy: String
	"When the occurrence mapping was created, as an ISO 8601 timestamp."
	created: String
}

"The link between a collection or an institution and the system that holds its master record."
type GbifMasterSourceMetadata {
	"Identifier for the master source metadata."
	key: Int
	"The system that holds the master record: DATASET, ORGANIZATION or IH_IRN."
	source: String
	"The identifier of the record in that system."
	sourceId: String
	"The GBIF username of the creator of the master source metadata."
	createdBy: String
	"Timestamp of when the master source metadata was created."
	created: String
}

"A page of collections, as GBIF answers it."
type GbifObjectGroupPage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifObjectGroup]
}

"""
A collection described in Latimer Core, the TDWG standard for describing natural science collections.
"""
type GbifObjectGroup {
	"The name of the collection."
	collectionName: String
	"A description of the collection."
	description: String
	"The scientific disciplines of the collection."
	discipline: [String]
	"The kind of collection."
	typeOfObjectGroup: [String]
	"The institution and the departments that hold the collection."
	hasOrganisationalUnit: [GbifOrganisationalUnit]
	"True when the collection still exists."
	isCurrentCollection: Boolean
	"How the objects are preserved."
	preservationMethod: [String]
	"The address of the collection."
	address: [GbifAddress]
	"The statuses of the collection."
	collectionStatusHistory: [GbifCollectionStatusHistory]
	"The ways to contact the collection."
	contactDetail: [GbifContactDetail]
	"The geographic scope of the collection."
	geographicContext: [GbifGeographicContext]
	"The identifiers of the collection."
	identifier: [GbifRegistryIdentifier]
	"Measurements and facts about the collection."
	measurementOrFact: [GbifLatimerMeasurementOrFact]
	"The people of the collection with their roles."
	personRole: [GbifPersonRole]
	"References to resources about the collection."
	reference: [GbifLatimerReference]
	"Resources related to the collection."
	resourceRelationship: [GbifResourceRelationship]
	"The classes of objects in the collection."
	objectClassification: [GbifObjectClassification]
}

"An institution or a department described in Latimer Core."
type GbifOrganisationalUnit {
	"The name of the institution or department."
	organisationalUnitName: String
	"The kind of unit, for example institution or department."
	organisationalUnitType: String
	"The address of the organisational unit."
	address: [GbifAddress]
	"The ways to contact the organisational unit."
	contactDetail: [GbifContactDetail]
	"The identifiers of the institution."
	identifier: [GbifRegistryIdentifier]
	"Measurements and facts about the organisational unit."
	measurementOrFact: [GbifLatimerMeasurementOrFact]
	"References to resources about the organisational unit."
	reference: [GbifLatimerReference]
}

"A way to contact a person or an organisation in Latimer Core, such as an email address."
type GbifContactDetail {
	"The contact, for example an email address."
	contactDetailValue: String
	"The kind of contact, for example email or phone."
	contactDetailCategory: String
}

"A measurement or a fact about a collection in Latimer Core, for example its number of objects."
type GbifLatimerMeasurementOrFact {
	"A fact as text."
	measurementFactText: String
	"The measured value."
	measurementValue: String
	"What was measured, for example number of objects."
	measurementType: String
}

"A reference to a resource about a collection in Latimer Core, such as its website."
type GbifLatimerReference {
	"The address of the resource."
	resourceIRI: String
	"The kind of resource, for example homepage."
	referenceType: String
	"The name of the resource."
	referenceName: String
}

"A status of a collection in Latimer Core, for example whether it is still active."
type GbifCollectionStatusHistory {
	"The status, for example active."
	status: String
	"The kind of status."
	statusType: String
}

"The geographic scope of a collection in Latimer Core."
type GbifGeographicContext {
	"Facts about the geographic scope."
	hasMeasurementOrFact: [GbifLatimerMeasurementOrFact]
}

"A person and the role they play for a collection in Latimer Core."
type GbifPersonRole {
	"The people who play the role."
	person: [GbifPerson]
	"The roles."
	role: [GbifRole]
	"Facts about the role."
	measurementOrFact: [GbifLatimerMeasurementOrFact]
}

"A person in Latimer Core."
type GbifPerson {
	"The given name of the person."
	givenName: String
	"The family name of the person."
	familyName: String
	"The address of the person."
	address: [GbifAddress]
	"The ways to contact the person."
	contactDetail: [GbifContactDetail]
	"The identifiers of the person, such as an ORCID."
	identifier: [GbifRegistryIdentifier]
	"Measurements and facts about the person."
	measurementOrFact: [GbifLatimerMeasurementOrFact]
}

"A role of a person in Latimer Core, such as curator."
type GbifRole {
	"The name of the role, for example curator."
	roleName: String
}

"A relationship between a collection and another resource in Latimer Core."
type GbifResourceRelationship {
	"The name of the related resource."
	relatedResourceName: String
	"How the resource relates to the collection."
	relationshipOfResource: String
}

"A class of objects in a collection in Latimer Core."
type GbifObjectClassification {
	"The name of the class, for example skins."
	objectClassificationName: String
	"The level of the class, for example type."
	objectClassificationLevel: String
}

"A page of datasets, as GBIF answers it."
type GbifDatasetPage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifDataset]
}

"""
A dataset of the GBIF registry: a set of occurrences, a checklist of names, records from sampling events, or
metadata only. An organization publishes it through an installation.
"""
type GbifDataset {
	"""
	Unique GBIF key for the dataset. This is used in theGBIF API, but outside GBIF it is best to refer to a dataset
	by its DOI.
	"""
	key: ID
	"If set, this dataset is a sub-dataset of the parent."
	parentDatasetKey: ID
	"""
	A dataset of which this dataset is a duplicate. Typically, this means this dataset is an old version of the
	duplicated dataset, which has replaced this dataset. Therefore **this link is usually found on deleted
	datasets**.
	"""
	duplicateOfDatasetKey: ID
	"""
	The installation providing access to the source dataset.
	*(NB Not required for updates.)*
	"""
	installationKey: ID
	"""
	The publishing organization publishing this dataset.
	*(NB Not required for updates.)*
	"""
	publishingOrganizationKey: ID
	"""
	The publishing organization name.
	*(NB Not required for updates.)*
	"""
	publishingOrganizationName: String
	"A list of GBIF Networks to which this dataset belongs."
	networkKeys: [ID]
	"The primary Digital Object Identifier (DOI) for this dataset."
	doi: String
	"The version of the published dataset."
	version: String
	"Not currently used."
	external: Boolean
	"If set, the number of sub-datasets of this parent dataset."
	numConstituents: Int
	"""
	The primary type of the dataset.
	*(NB Not required for updates.)*
	"""
	type: String
	"The sub-type of the dataset."
	subtype: String
	"Concise name of the dataset."
	shortName: String
	"""
	The title of the dataset.
	*(NB Not required for updates.)*
	"""
	title: String
	"An alias for this dataset. Rarely used."
	alias: String
	"An abbreviation for this dataset. Rarely used."
	abbreviation: String
	"A description of the dataset."
	description: String
	"""
	The language of the dataset metadata.
	*(NB Not required for updates.)*
	"""
	language: String
	"A homepage with further details on the dataset."
	homepage: String
	"A logo for the dataset, accessible over HTTP."
	logoUrl: String
	"The citation recommended by GBIF for use when citing this dataset."
	citation: GbifCitation
	"Contacts use to generate a citation."
	contactsCitation: [GbifCitationContact]
	"""
	Intellectual property rights applied to this dataset.
	*Rarely used, see license instead.*
	"""
	rights: String
	"""
	If true, any new or updated metadata is ignored.
	This is generally used when the publisher has technical problems or limitations with their publication system.
	"""
	lockedForAutoUpdate: Boolean
	"The GBIF username of the creator of the dataset."
	createdBy: String
	"The GBIF username of the last user to modify the dataset."
	modifiedBy: String
	"Timestamp of when the dataset was created."
	created: String
	"Timestamp of when the dataset was modified."
	modified: String
	"""
	If present, the dataset was deleted at this time. It is possible for it to be restored in the future.
	"""
	deleted: String
	"A list of contacts associated with this dataset."
	contacts: [GbifContact]
	"A list of endpoints associated with this dataset."
	endpoints: [GbifEndpoint]
	"A list of machine tags associated with this dataset."
	machineTags: [GbifMachineTag]
	"A list of tags associated with this dataset."
	tags: [GbifTag]
	"A list of identifiers associated with this dataset."
	identifiers: [GbifRegistryIdentifier]
	"A list of comments associated with this dataset."
	comments: [GbifComment]
	"Citations retrieved from this dataset's metadata documents."
	bibliographicCitations: [GbifCitation]
	"Curatorial unit information retrieved from this dataset's metadata documents."
	curatorialUnits: [GbifCuratorialUnitComposite]
	"Taxonomic coverage information retrieved from this dataset's metadata documents."
	taxonomicCoverages: [GbifTaxonomicCoverages]
	"Geographic coverage description retrieved from this dataset's metadata documents."
	geographicCoverageDescription: String
	"Geospatial coverage information retrieved from this dataset's metadata documents."
	geographicCoverages: [GbifGeospatialCoverage]
	"Keyword collections retrieved from this dataset's metadata documents."
	keywordCollections: [GbifKeywordCollection]
	"Project information retrieved from this dataset's metadata documents."
	project: GbifProject
	"Sampling description retrieved from this dataset's metadata documents."
	samplingDescription: GbifSamplingDescription
	"Country coverage information retrieved from this dataset's metadata documents."
	countryCoverage: [String]
	"Collection information retrieved from this dataset's metadata documents."
	collections: [GbifCollection]
	"Data description information retrieved from this dataset's metadata documents."
	dataDescriptions: [GbifDataDescription]
	"Data language information retrieved from this dataset's metadata documents."
	dataLanguage: String
	"Purpose information retrieved from this dataset's metadata documents."
	purpose: String
	"An overview of the background and context for the dataset."
	introduction: String
	"A high level overview of interpretation, structure, and content of the dataset."
	gettingStarted: String
	"Text that acknowledges funders and other key contributors."
	acknowledgements: String
	"Additional information retrieved from this dataset's metadata documents."
	additionalInfo: String
	"The publication date retrieved from this dataset's metadata documents."
	pubDate: String
	"The maintenance update frequency retrieved from this dataset's metadata documents."
	maintenanceUpdateFrequency: String
	"The maintenance description retrieved from this dataset's metadata documents."
	maintenanceDescription: String
	"The data and metadata license retrieved from this dataset's metadata documents."
	license: String
	"Basic metadata of the Darwin Core Archive (DwC-A) associated with this dataset."
	dwca: GbifDwcArchive
	"Category of this dataset."
	category: [String]
	"""
	Approximate record counts for this dataset, sourced from the dataset search index. Values are snapshots taken at
	index time and may lag live occurrence or checklist data. Useful to avoid extra calls for occurrence and
	name-usage totals; not authoritative.
	"""
	approximateCounts: GbifApproximateCounts
}

"How to cite a dataset."
type GbifCitation {
	"The citation text."
	text: String
	"The identifier of the citation, such as a DOI."
	identifier: String
	"True when the publisher wrote the citation, and false when GBIF generated it."
	citationProvidedBySource: Boolean
}

"A person named in the citation of a dataset."
type GbifCitationContact {
	"The key that identifies the contact in GBIF."
	key: Int
	"The name of the person as the citation shortens it, for example Smith J."
	abbreviatedName: String
	"The first name of the person."
	firstName: String
	"The last name of the person."
	lastName: String
	"The roles of the person, for example ORIGINATOR or METADATA_AUTHOR."
	roles: [String]
	"Identifiers of the person, such as an ORCID."
	userId: [String]
}

"An address where GBIF reads the data of a dataset, of an installation or of another entity."
type GbifEndpoint {
	"Identifier for the endpoint"
	key: Int
	"The protocol of the endpoint, for example DWC_ARCHIVE."
	type: String
	"The URL of the endpoint."
	url: String
	"A description of the endpoint."
	description: String
	"The GBIF username of the creator of the endpoint"
	createdBy: String
	"The GBIF username of the last user to modify the endpoint"
	modifiedBy: String
	"Timestamp of when the endpoint was created"
	created: String
	"Timestamp of when the endpoint was last modified"
	modified: String
	"Machine tags applied to the endpoint"
	machineTags: [GbifMachineTag]
}

"""
A count of the objects in a collection, such as 500 jars, either exact with a deviation or as a range.
"""
type GbifCuratorialUnitComposite {
	"The kind of objects counted, for example jars."
	type: String
	"The kind of objects as the dataset wrote it."
	typeVerbatim: String
	"The number of objects, when it is exact."
	count: Int
	"How far the exact number may be off."
	deviation: Int
	"The lowest number of objects, for a range."
	lower: Int
	"The highest number of objects, for a range."
	upper: Int
}

"The taxa that a dataset covers."
type GbifTaxonomicCoverages {
	"A description of the taxa covered."
	description: String
	"The taxa covered."
	coverages: [GbifTaxonomicCoverage]
}

"A taxon that a dataset covers."
type GbifTaxonomicCoverage {
	"The scientific name of the taxon."
	scientificName: String
	"The common name of the taxon."
	commonName: String
	"The rank of the taxon, as written and as interpreted."
	rank: GbifInterpretedRank
}

"A taxonomic rank as the dataset wrote it and as GBIF interpreted it."
type GbifInterpretedRank {
	"The value as the source wrote it."
	verbatim: String
	"The value as GBIF interpreted it."
	interpreted: String
}

"The area that a dataset covers."
type GbifGeospatialCoverage {
	"A description of the area covered."
	description: String
	"The rectangle on the map that holds the area."
	boundingBox: GbifBoundingBox
}

"A rectangle on the map, by its latitudes and longitudes in decimal degrees."
type GbifBoundingBox {
	"The southern edge, in decimal degrees."
	minLatitude: Float
	"The northern edge, in decimal degrees."
	maxLatitude: Float
	"The western edge, in decimal degrees."
	minLongitude: Float
	"The eastern edge, in decimal degrees."
	maxLongitude: Float
	"True when the dataset covers the whole world."
	globalCoverage: Boolean
}

"Keywords of a dataset from one thesaurus."
type GbifKeywordCollection {
	"The thesaurus that the keywords come from."
	thesaurus: String
	"The keywords."
	keywords: [String]
}

"The project that produced a dataset."
type GbifProject {
	"The title of the project."
	title: String
	"An identifier of the project, such as a DOI or a URL."
	identifier: String
	"A description of the project."
	description: String
	"The people to contact about the project."
	contacts: [GbifContact]
	"Who funded the project, in its own words."
	funding: String
	"The grants that funded the project."
	awards: [GbifProjectAward]
	"The area the project studied."
	studyAreaDescription: String
	"How the project was designed."
	designDescription: String
	"Projects related to this one."
	relatedProjects: [GbifRelatedProject]
	"A summary of the project."
	abstract: String
}

"A grant that funded a project."
type GbifProjectAward {
	"The name of the funder."
	funderName: String
	"Identifiers of the funder, such as a ROR or a Crossref Funder ID."
	funderIdentifiers: [String]
	"The number of the grant."
	awardNumber: String
	"The title of the award."
	title: String
	"The URL of the grant."
	awardUrl: String
}

"A project related to the project of a dataset."
type GbifRelatedProject {
	"The title of the project."
	title: String
	"An identifier of the project, such as a DOI or a URL."
	identifier: String
	"The people to contact about the project."
	contacts: [GbifContact]
	"A summary of the project."
	abstract: String
}

"How the data of a dataset was sampled."
type GbifSamplingDescription {
	"The extent of the study, in time and place."
	studyExtent: String
	"How the samples were taken."
	sampling: String
	"How the quality of the data was controlled."
	qualityControl: String
	"The steps of the sampling method."
	methodSteps: [String]
}

"""
A collection of natural history specimens in GRSciColl, GBIF's registry of scientific collections, such as the
mammals of a museum.
"""
type GbifCollection {
	"Unique GBIF key for the collection."
	key: ID
	"""
	Code of the collection ,  identifies a collection at the owner's location.
	*(NB Not required for updates.)*
	"""
	code: String
	"""
	Descriptive name of the collection.
	*(NB Not required for updates.)*
	"""
	name: String
	"Description or summary of the contents of the collection."
	description: String
	"Content type of the elements found in the collection."
	contentTypes: [String]
	"Whether the collection is active/maintained."
	active: Boolean
	"Whether this collection belongs to an individual."
	personalCollection: Boolean
	"A Digital Object Identifier for the collection."
	doi: String
	"Email addresses associated with the collection."
	email: [String]
	"Telephone numbers associated with the collection."
	phone: [String]
	"The collection's WWW homepage."
	homepage: String
	"URLs for interactive catalogues of the collection."
	catalogUrls: [String]
	"URLs for machine-readable APIs for the collection catalogue."
	apiUrls: [String]
	"The preservation mechanisms used for this collection."
	preservationTypes: [String]
	"How the collection was added or joined."
	accessionStatus: String
	"The key of the institution owning or hosting the collection."
	institutionKey: ID
	"The postal address of the collection."
	mailingAddress: GbifAddress
	"The address of the location of the collection."
	address: GbifAddress
	"The GBIF username of the creator of the collection entity in the GBIF registry."
	createdBy: String
	"The GBIF username of the last user to modify the collection entity in the GBIF registry."
	modifiedBy: String
	"Timestamp of when the collection entity was created in the GBIF registry."
	created: String
	"Timestamp of when the collection entity was modified in the GBIF registry."
	modified: String
	"""
	If present, the collection was deleted at this time. It is possible for it to be restored in the future.
	"""
	deleted: String
	"A list of tags associated with this collection."
	tags: [GbifTag]
	"A list of identifiers associated with this collection."
	identifiers: [GbifRegistryIdentifier]
	"A list of contact people for this collection."
	contactPersons: [GbifContact]
	"The number of specimens contained in this collection."
	numberSpecimens: Int
	"A list of machine tags associated with this collection."
	machineTags: [GbifMachineTag]
	"The taxonomic coverage of this collection."
	taxonomicCoverage: String
	"The geographic coverage of this collection."
	geographicCoverage: String
	"Notes on the collection."
	notes: String
	"Other collections incorporated into this collection."
	incorporatedCollections: [String]
	"Alternative codes for this collection."
	alternativeCodes: [GbifAlternativeCode]
	"A list of comments associated with this collection."
	comments: [GbifComment]
	"Mapping of a GRSciColl collection to occurrence records"
	occurrenceMappings: [GbifOccurrenceMapping]
	"A collection record that replaces this collection."
	replacedBy: ID
	"The primary source of this collection record."
	masterSource: String
	"""
	Information to assist the synchronization of the master source record with the record in the GBIF registry.
	"""
	masterSourceMetadata: GbifMasterSourceMetadata
	"An organizational department managing the collection."
	department: String
	"An organizational division managing the collection."
	division: String
	"Whether the collection is shown on the NHC portal."
	displayOnNHCPortal: Boolean
	"An estimate of the number of occurrences linked to the institution."
	occurrenceCount: Int
	"An estimate of the number of type specimens linked to the institution."
	typeSpecimenCount: Int
	"""
	URI to the image to be featured on the collection page, this image should be associated with a license.
	"""
	featuredImageUrl: String
	"The license associated with the image to be featured on the collection page."
	featuredImageLicense: String
	"""
	Temporal scope or focus of the collection. This free text field can be used to describe both the collection date
	ranges as well as the geological time group(s) of the collection objects in the context of paleontological
	collections.
	"""
	temporalCoverage: String
	"""
	Information about ownership, attribution, etc. of the featured image. This value with be used to generate a
	suggested citation of the image.
	"""
	featuredImageAttribution: String
}

"A file of a dataset that its metadata describes."
type GbifDataDescription {
	"The name of the file."
	name: String
	"The character set of the file, for example UTF-8."
	charset: String
	"The URL to download the file from."
	url: String
	"The format of the file, for example Darwin Core Archive."
	format: String
	"The version of the format."
	formatVersion: String
}

"The structure of the Darwin Core Archive of a dataset."
type GbifDwcArchive {
	"""
	This attribute, within the , indicates the specific type of data being represented in the core data file.**.
	"""
	coreType: String
	"""
	This attribute, within the , indicates the specific type of data being represented in the associated extension
	data file.**.
	"""
	extensions: [String]
	"Timestamp of when the dataset DwcA metadata was modified."
	modified: String
}

"""
Approximate record counts for this dataset, sourced from the dataset search index. Values are snapshots taken at
index time and may lag live occurrence or checklist data. Useful to avoid extra calls for occurrence and
name-usage totals; not authoritative.
"""
type GbifApproximateCounts {
	"Approximate number of occurrence records indexed for this dataset."
	occurrenceCount: Long
	"Approximate number of name usages for checklist datasets; typically null otherwise."
	nameUsageCount: Long
}

"A page of installations, as GBIF answers it."
type GbifInstallationPage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifInstallation]
}

"A technical installation which can serve datasets."
type GbifInstallation {
	"Unique GBIF key for the installation."
	key: ID
	"""
	The publishing organization managing this installation.
	*(NB Not required for updates.)*
	"""
	organizationKey: ID
	"""
	The type of the installation. Defines what protocols are usedfor communication.
	*(NB Not required for updates.)*
	"""
	type: String
	"""
	A name for the installation.
	*(NB Not required for updates.)*
	"""
	title: String
	"A description for the installation."
	description: String
	"The GBIF username of the creator of the installation."
	createdBy: String
	"The GBIF username of the last user to modify the installation."
	modifiedBy: String
	"Timestamp of when the installation was created."
	created: String
	"Timestamp of when the installation was modified."
	modified: String
	"""
	If present, the installation was deleted at this time. It is possible for it to be restored in the future.
	"""
	deleted: String
	"""
	Whether the installation is disabled. A disabled installation is not checked for new or deleted datasets, or
	metadata changes to existingdatasets. However, data updates from existing datasets are not affected.
	"""
	disabled: Boolean
	"A list of contacts associated with this installation."
	contacts: [GbifContact]
	"A list of endpoints associated with this installation."
	endpoints: [GbifEndpoint]
	"A list of machine tags associated with this installation."
	machineTags: [GbifMachineTag]
	"A list of tags associated with this installation."
	tags: [GbifTag]
	"A list of identifiers associated with this installation."
	identifiers: [GbifRegistryIdentifier]
	"A list of comments associated with this installation."
	comments: [GbifComment]
}

"A page of institutions, as GBIF answers it."
type GbifInstitutionPage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifInstitution]
}

"""
An institution in GRSciColl, GBIF's registry of scientific collections, such as a museum, a herbarium or a
university.
"""
type GbifInstitution {
	"Unique GBIF key for the institution."
	key: ID
	"""
	Code used to identify the institution.
	*(NB Not required for updates.)*
	"""
	code: String
	"""
	Name or title of the institution.
	*(NB Not required for updates.)*
	"""
	name: String
	"Description of the institution."
	description: String
	"Types of the institution, describing its main activities."
	types: [String]
	"Whether the institution is active or operational."
	active: Boolean
	"Email addresses associated with the institution."
	email: [String]
	"Telephone numbers associated with the instutiton."
	phone: [String]
	"The institution's WWW homepage."
	homepage: String
	"URLs for the main interactive catalogues of the institution."
	catalogUrls: [String]
	"URLs for machine-readable APIs for the institution catalogues."
	apiUrls: [String]
	"The mechanisms, processes and relations by which an institution is controlled and directed."
	institutionalGovernances: [String]
	"The academic or research disciplines to which an institution is dedicated."
	disciplines: [String]
	"The latitude of the institution."
	latitude: Float
	"The longitude of the institution."
	longitude: Float
	"The postal address of the institution."
	mailingAddress: GbifAddress
	"The address of the location of the institution."
	address: GbifAddress
	"Additional names by which the institution is known."
	additionalNames: [String]
	"The date the institution was founded or established."
	foundingDate: Int
	"An estimate of the number of specimens hosted by the institution."
	numberSpecimens: Int
	"A URL to a logo for the institution."
	logoUrl: String
	"The GBIF username of the creator of the institution entity in the GBIF registry."
	createdBy: String
	"The GBIF username of the last user to modify the institution entity in the GBIF registry."
	modifiedBy: String
	"Timestamp of when the institution entity was created in the GBIF registry."
	created: String
	"Timestamp of when the institution entity was modified in the GBIF registry."
	modified: String
	"""
	If present, the institution was deleted at this time. It is possible for it to be restored in the future.
	"""
	deleted: String
	"A list of tags associated with this institution."
	tags: [GbifTag]
	"A list of identifiers associated with this institution."
	identifiers: [GbifRegistryIdentifier]
	"A list of contact people for this institution."
	contactPersons: [GbifContact]
	"A list of machine tags associated with this institution."
	machineTags: [GbifMachineTag]
	"Alternative codes for this institution."
	alternativeCodes: [GbifAlternativeCode]
	"A list of comments associated with this institution."
	comments: [GbifComment]
	"Mapping of a GRSciColl institution to occurrence records"
	occurrenceMappings: [GbifOccurrenceMapping]
	"A collection record that replaces this collection."
	replacedBy: ID
	"""
	Indicates if the institution was converted to a collection and specifies the UUID key of that collection
	"""
	convertedToCollection: ID
	"The primary source of this institution record."
	masterSource: String
	"""
	Information to assist the synchronization of the master source record with the record in the GBIF registry.
	"""
	masterSourceMetadata: GbifMasterSourceMetadata
	"Whether the institution is shown on the NHC portal."
	displayOnNHCPortal: Boolean
	"An estimate of the number of occurrences linked to the institution."
	occurrenceCount: Int
	"An estimate of the number of type specimens linked to the institution."
	typeSpecimenCount: Int
	"""
	URI to the image to be featured on the institution page, this image should be associated with a license.
	"""
	featuredImageUrl: String
	"The license associated with the image to be featured on the institution page."
	featuredImageLicense: String
	"""
	Information about ownership, attribution, etc. of the featured image. This value with be used to generate a
	suggested citation of the image.
	"""
	featuredImageAttribution: String
}

"A page of organisational units, as GBIF answers it."
type GbifOrganisationalUnitPage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifOrganisationalUnit]
}

"A page of networks, as GBIF answers it."
type GbifNetworkPage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifNetwork]
}

"""
Networks are collections of datasets, organized outside the Node-Organization model to serve some purpose.
"""
type GbifNetwork {
	"Unique GBIF key for the network."
	key: ID
	"""
	A name for the network.
	*(NB Not required for updates.)*
	"""
	title: String
	"A description for the network."
	description: String
	"""
	The language of the network metadata.
	*(NB Not required for updates.)*
	"""
	language: String
	"The number of datasets collected in this network."
	numConstituents: Int
	"Email addresses associated with this network."
	email: [String]
	"Telephone numbers associated with this network."
	phone: [String]
	"Homepages with further details on the network."
	homepage: [String]
	"A logo for the network, accessible over HTTP."
	logoUrl: String
	"Address lines other than the city, province, country andpostal code, which have their own fields."
	address: [String]
	"The city or similar line of the network's address."
	city: String
	"The province or similar line of the network's address."
	province: String
	"The country or other region of the network's address."
	country: String
	"The postal code or similar line of the network's address."
	postalCode: String
	"The GBIF username of the creator of the network."
	createdBy: String
	"The GBIF username of the last user to modify the network."
	modifiedBy: String
	"Timestamp of when the network was created."
	created: String
	"Timestamp of when the network was modified."
	modified: String
	"""
	If present, the network was deleted at this time. It is possible for it to be restored in the future.
	"""
	deleted: String
	"A list of contacts associated with this network."
	contacts: [GbifContact]
	"A list of endpoints associated with this network."
	endpoints: [GbifEndpoint]
	"A list of machine tags associated with this network."
	machineTags: [GbifMachineTag]
	"A list of tags associated with this network."
	tags: [GbifTag]
	"A list of identifiers associated with this network."
	identifiers: [GbifRegistryIdentifier]
	"A list of comments associated with this network."
	comments: [GbifComment]
}

"A page of nodes, as GBIF answers it."
type GbifNodePage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifNode]
}

"""
A participant node, a country and its nominated organization or an international organization which is a member
of GBIF.
Note that participant nodes are managed in an internal GBIF system,so methods to create, update and delete
participant nodes are generally used only to synchronize the two systems.
"""
type GbifNode {
	"Unique GBIF key for the participant node."
	key: ID
	"The membership type of the participant node."
	type: String
	"The membership status of the participant node."
	participationStatus: String
	"The year the participant node first joined GBIF."
	participantSince: Int
	"The date the participant node signed the GBIF Memorandum of Understanding."
	dateSignedMOU: String
	"The political region, based on IPBES regions, to which this participant node belongs."
	gbifRegion: String
	"The name of the participant node."
	title: String
	"The name of the participant."
	participantTitle: String
	"The abbreviation for the participant node."
	abbreviation: String
	"The description of the participant node."
	description: String
	"Email addresses associated with this participant node."
	email: [String]
	"Telephone numbers associated with this participant node."
	phone: [String]
	"Homepages with further details on the participant node."
	homepage: [String]
	"A logo for the participant node, accessible over HTTP."
	logoUrl: String
	"Address lines other than the city, province, country andpostal code, which have their own fields."
	address: [String]
	"The city or similar line of the participant node's address."
	city: String
	"The province or similar line of the participant node's address."
	province: String
	"The country or other region of the participant node's address."
	country: String
	"The postal code or similar line of the participant node's address."
	postalCode: String
	"The GBIF username of the creator of the participant node."
	createdBy: String
	"The GBIF username of the last user to modify the participant node."
	modifiedBy: String
	"Timestamp of when the participant node was created *in the Registry*. See also, participantSince."
	created: String
	"Timestamp of when the participant node was modified."
	modified: String
	"""
	If present, the participant node was deleted at this time. It is possible for it to be restored in the future.
	"""
	deleted: String
	"A list of contacts associated with this participant node."
	contacts: [GbifContact]
	"A list of endpoints associated with this participant node."
	endpoints: [GbifEndpoint]
	"A list of machine tags associated with this participant node."
	machineTags: [GbifMachineTag]
	"A list of tags associated with this participant node."
	tags: [GbifTag]
	"A list of identifiers associated with this participant node."
	identifiers: [GbifRegistryIdentifier]
	"A list of comments associated with this participant node."
	comments: [GbifComment]
}

"A page of organizations, as GBIF answers it."
type GbifOrganizationPage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifOrganization]
}

"""
A publishing organization is an institution endorsed by a GBIF Participant Node to publish datasets to GBIF.
"""
type GbifOrganization {
	"Unique GBIF key for the publishing organization."
	key: ID
	"""
	The participant node which has endorsed or would endorse this publishing organization.
	*(NB Not required for updates.)*
	"""
	endorsingNodeKey: ID
	"""
	Whether the participant node in endorsingNodeKey has endorsed this publishing organization ,  whether
	endorsementStatus == ENDORSED.
	"""
	endorsementApproved: Boolean
	"""
	The endorsement decision regarding this publishing organization made by the participant node in
	endorsingNodeKey.
	"""
	endorsementStatus: String
	"""
	The title of the publishing organization.
	*(NB Not required for updates.)*
	"""
	title: String
	"The abbreviation for the publishing organization."
	abbreviation: String
	"The description of the publishing organization."
	description: String
	"""
	The primary language of the description of the publishing organization.
	*(NB Not required for updates.)*
	"""
	language: String
	"Email addresses associated with this publishing organization."
	email: [String]
	"Telephone numbers associated with this publishing organization."
	phone: [String]
	"Homepages with further details on the publishing organization."
	homepage: [String]
	"A logo for the publishing organization, accessible over HTTP."
	logoUrl: String
	"Address lines other than the city, province, country andpostal code, which have their own fields."
	address: [String]
	"The city or similar line of the publishing organization's address."
	city: String
	"The province or similar line of the publishing organization's address."
	province: String
	"The country or other region of the publishing organization's address."
	country: String
	"The postal code or similar line of the publishing organization's address."
	postalCode: String
	"The latitude of the publishing organization."
	latitude: Float
	"The longitude of the publishing organization."
	longitude: Float
	"The number of datasets publishing by this publishing organization."
	numPublishedDatasets: Int
	"The GBIF username of the creator of the publishing organization."
	createdBy: String
	"The GBIF username of the last user to modify the publishing organization."
	modifiedBy: String
	"Timestamp of when the publishing organization was created."
	created: String
	"Timestamp of when the publishing organization was modified."
	modified: String
	"""
	If present, the publishing organization was deleted at this time. It is possible for it to be restored in the
	future.
	"""
	deleted: String
	"The time when this publishing organization was endorsed by the linked participant node."
	endorsed: String
	"A list of contacts associated with this publishing organization."
	contacts: [GbifContact]
	"A list of endpoints associated with this publishing organization."
	endpoints: [GbifEndpoint]
	"A list of machine tags associated with this publishing organization."
	machineTags: [GbifMachineTag]
	"A list of tags associated with this publishing organization."
	tags: [GbifTag]
	"A list of identifiers associated with this publishing organization."
	identifiers: [GbifRegistryIdentifier]
	"A list of comments associated with this publishing organization."
	comments: [GbifComment]
}

"A collection or an institution that a search of GRSciColl found."
type GbifCollectionsSearchResult {
	"The key that identifies the collection or institution in GBIF."
	key: ID
	"The code of the collection or institution, such as the acronym of an institution."
	code: String
	"The name of the collection or institution."
	name: String
	"Other codes of the collection or institution."
	alternativeCodes: [GbifAlternativeCode]
	"A description of the collection or institution."
	description: String
	"True while the collection or institution is active."
	active: Boolean
	"True when GBIF shows the collection or institution on its portal of natural history collections."
	displayOnNHCPortal: Boolean
	"The country, as an ISO 3166-1 alpha-2 code such as BE."
	country: String
	"The country of the mailing address of the collection or institution, as an ISO 3166-1 alpha-2 code."
	mailingCountry: String
	"The city of the collection or institution."
	city: String
	"The city of the mailing address of the collection or institution."
	mailingCity: String
	"The period that the specimens of the collection or institution cover, in its own words."
	temporalCoverage: String
	"The license of the featured image."
	featuredImageLicense: String
	"The URL of an image that represents the collection or institution."
	featuredImageUrl: String
	"Who to credit for the featured image."
	featuredImageAttribution: String
	"""
	The system that holds the master record of the collection or institution: GRSCICOLL, GBIF_REGISTRY or IH for
	Index Herbariorum.
	"""
	masterSource: String
	"The parts of the fields of the collection or institution that matched the search text."
	highlights: [GbifHighlight]
	"Whether the result is a COLLECTION or an INSTITUTION."
	type: String
	"The key of the institution that holds the collection."
	institutionKey: ID
	"The code of the institution that holds the collection."
	institutionCode: String
	"The name of the institution that holds the collection."
	institutionName: String
	"The descriptors of the collection or institution that matched the search."
	descriptorMatches: [GbifDescriptorMatch]
}

"A part of a field that matched the search text."
type GbifHighlight {
	"The field that matched."
	field: String
	"The part of the field that matched, with the matching words marked."
	snippet: String
}

"A descriptor of a collection that matched a search, such as a taxon the collection holds."
type GbifDescriptorMatch {
	"The key that identifies the descriptor in GBIF."
	key: Long
	"The key of the descriptor group."
	descriptorGroupKey: Long
	"The scientific name of the taxon."
	usageName: String
	"The key of the taxon in the GBIF backbone taxonomy."
	usageKey: String
	"The rank of the taxon."
	usageRank: String
	"The key of the checklist that GBIF matched the taxon in."
	checklistKey: String
	"The country, as an ISO 3166-1 alpha-2 code such as BE."
	country: String
	"The number of specimens."
	individualCount: Int
	"Who identified the specimens."
	identifiedBy: [String]
	"When the specimens were identified."
	dateIdentified: String
	"The type status of the specimens, for example HOLOTYPE."
	typeStatus: [String]
	"Who collected the specimens."
	recordedBy: [String]
	"The scientific discipline, for example zoology."
	discipline: String
	"The kind of objects, for example skins or skeletons."
	objectClassification: String
	"The biome the specimens come from."
	biome: String
	"The type of the biome."
	biomeType: String
	"The problems GBIF found while it interpreted the descriptor."
	issues: [String]
}

"A page of datasets, as GBIF answers it."
type GbifDatasetSearchPage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifDatasetSearchResult]
	"""
	The resulting facets of a search operation. The list can be empty if no facets were requested.
	If there are no values for a facet, it will not be included in the list, i.e.: a facet should have at least 1
	occurrence.
	"""
	facets: [GbifDatasetFacetCounts]
}

"A dataset that a full-text search found."
type GbifDatasetSearchResult {
	"The key that identifies the dataset in GBIF."
	key: ID
	"The title of the dataset."
	title: String
	"The DOI of the dataset, for example 10.15468/dl.abcd12."
	doi: String
	"A description of the dataset."
	description: String
	"The type of the dataset, for example OCCURRENCE or CHECKLIST."
	type: String
	"The subtype of the dataset."
	subtype: String
	"The text the search looks in."
	fullText: String
	"The key of the organization that hosts the installation of the dataset."
	hostingOrganizationKey: ID
	"The name of the organization that hosts the installation of the dataset."
	hostingOrganizationTitle: String
	"The country of the organization that hosts the dataset."
	hostingCountry: String
	"The name of the publisher of the dataset."
	publisherTitle: String
	"The countries that the dataset covers, as ISO 3166-1 alpha-2 codes."
	countryCoverage: [String]
	"The continents that the dataset covers."
	continent: [String]
	"The country of the organization that publishes the dataset."
	publishingCountry: String
	"The key of the organization that publishes the dataset."
	publishingOrganizationKey: ID
	"The name of the organization that publishes the dataset."
	publishingOrganizationTitle: String
	"When the dataset was published."
	publicationDate: String
	"When the dataset was last changed, as an ISO 8601 timestamp."
	modified: String
	"The key of the GBIF node that endorsed the publisher."
	endorsingNodeKey: ID
	"The keys of the networks that the dataset belongs to."
	networkKeys: [ID]
	"The license of the dataset, for example CC_BY_4_0."
	license: String
	"The decades that the records of the dataset come from, for example 2010."
	decades: [Int]
	"Keywords of the dataset."
	keywords: [String]
	"The identifier of the project that produced the dataset."
	projectIdentifier: String
	"The number of occurrences in the dataset."
	recordCount: Int
	"The number of name usages in a checklist dataset."
	nameUsagesCount: Int
	"The categories of the dataset."
	category: [String]
}

"The number of datasets for each value of one field, across all matches of a search."
type GbifDatasetFacetCounts {
	"The name of the field."
	field: String
	"The values of the field, each with its number of results."
	counts: [GbifCount]
}

"A collection or an institution that matches the start of a name, for an autocomplete."
type GbifKeyCodeName {
	"The key that identifies the collection or institution in GBIF."
	key: ID
	"The code of the collection or institution, such as the acronym of an institution."
	code: String
	"The name of the collection or institution."
	name: String
}

"A dataset that matches the start of a title, for an autocomplete."
type GbifDatasetSuggestResult {
	"The key that identifies the dataset in GBIF."
	key: ID
	"The title of the dataset."
	title: String
	"A description of the dataset."
	description: String
	"The type of the dataset, for example OCCURRENCE or CHECKLIST."
	type: String
	"The subtype of the dataset."
	subtype: String
}

"An entity of the GBIF registry that matches the start of a title, for an autocomplete."
type GbifKeyTitle {
	"The key that identifies the entity in GBIF."
	key: ID
	"The title of the entity."
	title: String
}

"""
A derived dataset: a citable set of occurrences that a user assembled from GBIF data, outside a GBIF download.
"""
type GbifDerivedDataset {
	"The DOI of the derived dataset."
	doi: String
	"The DOI of the source (large) download which has been filtered."
	originalDownloadDOI: String
	"Description of the derived dataset, such as how it was filtered."
	description: String
	"The citation for the derived dataset."
	citation: String
	"The human title of the derived dataset."
	title: String
	"The URL where the derived dataset is deposited."
	sourceUrl: String
	"The GBIF user who created the derived dataset."
	createdBy: String
	"The GBIF user who last modified the derived dataset."
	modifiedBy: String
	"When the derived dataset was registered with its DOI."
	registrationDate: String
	"The time the derived dataset was created."
	created: String
	"The time the derived dataset was last modified."
	modified: String
	"Categories that describe the derived dataset."
	category: [String]
}

"A page of derived datasets, as GBIF answers it."
type GbifDerivedDatasetPage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifDerivedDataset]
}

"A page of institutions, as GBIF answers it."
type GbifInstitutionSearchPage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifInstitutionSearchResult]
}

"An institution that a search of GRSciColl found."
type GbifInstitutionSearchResult {
	"The key that identifies the institution in GBIF."
	key: ID
	"The code of the institution, such as the acronym of an institution."
	code: String
	"The name of the institution."
	name: String
	"Other codes of the institution."
	alternativeCodes: [GbifAlternativeCode]
	"A description of the institution."
	description: String
	"True while the institution is active."
	active: Boolean
	"True when GBIF shows the institution on its portal of natural history collections."
	displayOnNHCPortal: Boolean
	"The country, as an ISO 3166-1 alpha-2 code such as BE."
	country: String
	"The country of the mailing address of the institution, as an ISO 3166-1 alpha-2 code."
	mailingCountry: String
	"The city of the institution."
	city: String
	"The city of the mailing address of the institution."
	mailingCity: String
	"The period that the specimens of the institution cover, in its own words."
	temporalCoverage: String
	"The license of the featured image."
	featuredImageLicense: String
	"The URL of an image that represents the institution."
	featuredImageUrl: String
	"Who to credit for the featured image."
	featuredImageAttribution: String
	"""
	The system that holds the master record of the institution: GRSCICOLL, GBIF_REGISTRY or IH for Index
	Herbariorum.
	"""
	masterSource: String
	"The parts of the fields of the institution that matched the search text."
	highlights: [GbifHighlight]
	"The kinds of the institution, for example MUSEUM or HERBARIUM."
	types: [String]
	"Who governs the institution, for example ACADEMIC_PUBLIC."
	institutionalGovernances: [String]
	"The scientific disciplines of the institution, for example ZOOLOGY."
	disciplines: [String]
	"The latitude of the institution in decimal degrees."
	latitude: Float
	"The longitude of the institution in decimal degrees."
	longitude: Float
	"The year the institution was founded."
	foundingDate: Int
	"The number of specimens the institution holds, by its own estimate."
	numberSpecimens: Int
	"The number of occurrences in GBIF that are linked to the institution."
	occurrenceCount: Int
	"The number of type specimens in GBIF that are linked to the institution."
	typeSpecimenCount: Int
}

"A page of collections, as GBIF answers it."
type GbifCollectionSearchPage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifCollectionSearchResult]
	"The counts of the values of the fields that the facets argument named."
	facets: [GbifCollectionFacetCounts]
}

"A collection that a search of GRSciColl found."
type GbifCollectionSearchResult {
	"The key that identifies the collection in GBIF."
	key: ID
	"The code of the collection, such as the acronym of an institution."
	code: String
	"The name of the collection."
	name: String
	"Other codes of the collection."
	alternativeCodes: [GbifAlternativeCode]
	"A description of the collection."
	description: String
	"True while the collection is active."
	active: Boolean
	"True when GBIF shows the collection on its portal of natural history collections."
	displayOnNHCPortal: Boolean
	"The country, as an ISO 3166-1 alpha-2 code such as BE."
	country: String
	"The country of the mailing address of the collection, as an ISO 3166-1 alpha-2 code."
	mailingCountry: String
	"The city of the collection."
	city: String
	"The city of the mailing address of the collection."
	mailingCity: String
	"The period that the specimens of the collection cover, in its own words."
	temporalCoverage: String
	"The license of the featured image."
	featuredImageLicense: String
	"The URL of an image that represents the collection."
	featuredImageUrl: String
	"Who to credit for the featured image."
	featuredImageAttribution: String
	"""
	The system that holds the master record of the collection: GRSCICOLL, GBIF_REGISTRY or IH for Index Herbariorum.
	"""
	masterSource: String
	"The parts of the fields of the collection that matched the search text."
	highlights: [GbifHighlight]
	"What the collection holds, for example BIOLOGICAL_PRESERVED_ORGANISMS."
	contentTypes: [String]
	"True when the collection belongs to a person."
	personalCollection: Boolean
	"How the specimens are preserved, for example STORAGE_FROZEN."
	preservationTypes: [String]
	"Whether the collection is part of the institution's holdings, for example INSTITUTIONAL."
	accessionStatus: String
	"The key of the institution that holds the collection."
	institutionKey: ID
	"The code of the institution that holds the collection."
	institutionCode: String
	"The name of the institution that holds the collection."
	institutionName: String
	"The number of specimens the collection holds, by its own estimate."
	numberSpecimens: Int
	"The taxa that the collection covers, in its own words."
	taxonomicCoverage: String
	"The places that the specimens of the collection come from, in its own words."
	geographicCoverage: String
	"The department of the institution that holds the collection."
	department: String
	"The division of the institution that holds the collection."
	division: String
	"The number of occurrences in GBIF that are linked to the collection."
	occurrenceCount: Int

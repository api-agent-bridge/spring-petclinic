	count: Long
	"Search results."
	results: [GbifLabel]
}

"A page of hidden labels, as GBIF answers it."
type GbifHiddenLabelPage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifHiddenLabel]
}

"A hidden label of a concept: a common misspelling or variant that still finds the concept."
type GbifHiddenLabel {
	"The key that identifies the hidden label in GBIF."
	key: Long
	"The text of the hidden label."
	value: String
	"The GBIF account that created the hidden label."
	createdBy: String
	"When the hidden label was created, as an ISO 8601 timestamp."
	created: String
}

"A concept that a label matched, with the label that matched."
type GbifConceptLookupResult {
	"The name of the concept that matched."
	conceptName: String
	"The address of the concept in the GBIF API."
	conceptLink: String
	"The label that matched."
	matchedLabel: String
	"The language of the label that matched."
	matchedLabelLanguage: String
	"The alternative label that matched."
	matchedAlternativeLabel: String
	"The language of the alternative label that matched."
	matchedAlternativeLabelLanguage: String
	"The hidden label that matched."
	matchedHiddenLabel: String
}

"A publication that uses or cites GBIF data, from GBIF's literature tracking."
type GbifLiteratureSearchResult {
	"The date the literature item was found by GBIF's staff or automated processes."
	discovered: String
	"Countries or areas of focus of the study."
	countriesOfCoverage: [String]
	"Countries or areas of institution with which authors are affiliated."
	countriesOfResearcher: [String]
	"Country of the publisher whose dataset is referenced in publication."
	publishingCountry: [String]
	"The date the publication was added to the GBIF literature database."
	added: String
	"The publication date of the publication. See also year, month and day."
	published: String
	"The day of publication. See also published."
	day: Int
	"Keys of GBIF downloads referenced by the publication."
	gbifDownloadKey: [String]
	"Keys of GBIF occurrences directly mentioned by the paper."
	gbifOccurrenceKey: [Long]
	"Keys of taxa from the GBIF Backbone Taxonomy that are the focus of the paper."
	gbifTaxonKey: [Int]
	"Keys of higher taxa from the GBIF Backbone Taxonomy that are the focus of the paper."
	gbifHigherTaxonKey: [Int]
	"A list of GBIF network keys relevant to the publication."
	gbifNetworkKey: [ID]
	"A list of GBIF project identifiers relevant to the publication."
	gbifProjectIdentifier: [String]
	"A list of GBIF programmes relevant to the publication."
	gbifProgramme: [String]
	"The manner in which GBIF is cited in a paper."
	citationType: String
	"GBIF regions (political divisions) related to the publication."
	gbifRegion: [String]
	"GBIF identifier for this literature item."
	id: ID
	"Keywords assigned to the literature item."
	keywords: [String]
	"The language of the publication."
	language: String
	"Type of literature, e.g. journal article."
	literatureType: String
	"The month of publication. See also published."
	month: Int
	"Unstructured notes."
	notes: String
	"Whether the publication is open access."
	openAccess: Boolean
	"Whether the publication has been peer reviewed."
	peerReview: Boolean
	"The publisher of the paper."
	publisher: String
	"Relevance to GBIF community, see literature relevance."
	relevance: [String]
	"Journal of publication."
	source: String
	"Various tags applied to the literature."
	tags: [String]
	"The title of the publication."
	title: String
	"Topics of the publication."
	topics: [String]
	"The date this literature entry was last modified."
	modified: String
	"Websites associated with the publication."
	websites: [String]
	"The year of publication. See also published."
	year: Int
	"The abstract from the publication."
	abstract: String
}

"""
A taxonomic rank in GBIF's checklists, from DOMAIN down to forms and strains. SPECIES, GENUS, FAMILY, ORDER,
CLASS, PHYLUM and KINGDOM are the common ones; SUBSPECIES and VARIETY are below the species.
"""

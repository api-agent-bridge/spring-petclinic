	"""
	Counts the occurrences, the records of where and when an organism was seen or collected, for a taxon, a country,
	a dataset or a year.
	Occurrence counts.
	Returns occurrence counts for a predefined set of dimensions.
	The supported dimensions are enumerated in the [/occurrence/count/schema](#operation/getOccurrenceCountSchema)
	service. The keys should be supplied as query parameters.
	An example for the count of georeferenced observations from Canada:
	/occurrence/count?country=CA&isGeoreferenced=true&basisOfRecord=OBSERVATION.
	"""
	gbifOccurrenceCount(
		"Count records with a particular basisOfRecord."
		basisOfRecord: GbifBasisOfRecord
		"Count records in the given country."
		country: GbifCountry
		"Count records in a dataset."
		datasetKey: ID
		"Count only georeferenced (or not) records."
		isGeoreferenced: Boolean
		"Count only records with this issue."
		issue: GbifOccurrenceCountIssue
		"Count records retrieved using the chosen protocol."
		protocol: GbifEndpointType
		"Count records published by the given country."
		publishingCountry: GbifCountry
		"Count records of a particular taxon."
		taxonKey: String
		"Count records with this type status."
		typeStatus: GbifTypeStatus
		"Count records from this year to current year or given range"
		year: Int
		"""
		*Experimental.* The checklist key. This determines which taxonomy will be used for the search in conjunction
		with other taxon keys. If this is not specified, the GBIF backbone taxonomy will be used.
		"""
		checklistKey: String
	): Long


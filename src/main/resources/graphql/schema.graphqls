}

"A page of occurrences, as GBIF answers it."
type GbifOccurrenceSearchPage {
	"True if this page of search results is the final page."
	endOfRecords: Boolean
	"The total number of records returned by the search."
	count: Long
	"Search results."
	results: [GbifOccurrence]
	"""
	The resulting facets of a search operation. The list can be empty if no facets were requested.
	If there are no values for a facet, it will not be included in the list, i.e.: a facet should have at least 1
	occurrence.
	"""
	facets: [GbifOccurrenceFacetCounts]
}

"""
An occurrence: a record of an organism at a place and a time, such as an observation of a dog in Antwerp or a
specimen in a museum. GBIF interprets each record, matches its name to the GBIF backbone taxonomy and flags the
problems it finds as issues.
"""
type GbifOccurrence {
	"""
	Unique GBIF key for the occurrence.
	We aim to keep these keys stable, but this is not possible in every case.
	"""
	key: Long
	"The UUID of the GBIF dataset containing this occurrence."
	datasetKey: ID
	"The UUID of the organization which publishes the dataset containing this occurrence."
	publishingOrgKey: ID
	"Any networks to which the dataset containing this occurrence is registered."
	networkKeys: [ID]
	"Categories assigned to the dataset containing this occurrence."
	datasetCategory: [String]
	"The UUID of the technical installation hosted the dataset containing this occurrence."
	installationKey: ID
	"""
	The UUID of the publishing organization which operates the technical installation hosting the dataset containing
	this occurrence.
	"""
	hostingOrganizationKey: ID
	"""
	The country, territory or island based on ISO-3166 of the organization publishing the dataset containing this
	occurrence.
	"""
	publishingCountry: String
	"The technical protocol by which this occurrence was retrieved from the publisher's systems."
	protocol: String
	"The time this occurrence was last retrieved from the publisher's systems."
	lastCrawled: String
	"""
	The time this occurrence was last processed by GBIF's interpretation system “Pipelines”.
	This is the time the record was last changed in GBIF, **not** the time the record was last changed by the
	publisher. Data is also reprocessed when we changed the taxonomic backbone, geographic data sources or other
	interpretation procedures.
	An earlier interpretation system distinguished between “parsing” and “interpretation”, but in the current system
	there is only one process ,  the two dates will always be the same.
	"""
	lastParsed: String
	"""
	The sequence number of the attempt by GBIF to download (”crawl”), interpret and index the dataset to which this
	occurrence belongs.
	"""
	crawlId: Int
	"The identifier for a project, often assigned by a funded programme."
	projectId: String
	"The identifier for a programme which funded the digitization of this occurrence."
	programmeAcronym: String
	"""
	The values of the Darwin Core term Basis of Record which can apply to occurrences.
	See GBIF's Darwin Core Type Vocabulary for definitions.
	"""
	basisOfRecord: String
	"The number of individuals present at the time of the Occurrence."
	individualCount: Int
	"""
	A statement about the presence or absence of a Taxon at a Location.
	For definitions, see the GBIF occurrence status vocabulary.
	"""
	occurrenceStatus: String
	"The sex of the organism, for example Male or Female, from the GBIF vocabulary Sex."
	sex: String
	"""
	The age class or life stage of the Organism(s) at the time the Occurrence was recorded.
	Values are aligned to the GBIF LifeStage vocabulary
	"""
	lifeStage: String
	"""
	Statement about whether an organism or organisms have been introduced to a given place and time through the
	direct or indirect activity of modern humans.
	Values are aligned to the GBIF EstablishmentMeans vocabulary, which is derived from the Darwin Core
	EstablishmentMeans vocabulary.
	"""
	establishmentMeans: String
	"""
	The degree to which an Organism survives, reproduces, and expands its range at the given place and time.
	Values are aligned to the GBIF DegreeOfEstablishment vocabulary, which is derived from the Darwin Core
	DegreeOfEstablishment vocabulary.
	"""
	degreeOfEstablishment: String
	"""
	The process by which an Organism came to be in a given place at a given time.
	Values are aligned to the GBIF Pathway vocabulary, which is derived from the Darwin Core Pathway vocabulary.
	"""
	pathway: String
	"""
	A taxon key from the GBIF backbone for the most specific (lowest rank) taxon for this occurrence. This could be
	a synonym, see acceptedTaxonKey.
	"""
	taxonKey: Int
	"A taxon key from the GBIF backbone for the kingdom of thisoccurrence."
	kingdomKey: Int
	"A taxon key from the GBIF backbone for the phylum of thisoccurrence."
	phylumKey: Int
	"A taxon key from the GBIF backbone for the class of thisoccurrence."
	classKey: Int
	"A taxon key from the GBIF backbone for the order of thisoccurrence."
	orderKey: Int
	"A taxon key from the GBIF backbone for the family of thisoccurrence."
	familyKey: Int
	"A taxon key from the GBIF backbone for the genus of thisoccurrence."
	genusKey: Int
	"A taxon key from the GBIF backbone for the subgenus of thisoccurrence."
	subgenusKey: Int
	"A taxon key from the GBIF backbone for the species of thisoccurrence."
	speciesKey: Int
	"A taxon key from the GBIF backbone for the accepted taxon of this occurrence."
	acceptedTaxonKey: Int
	"""
	The scientific name (including authorship) for the taxon from the GBIF backbone matched to this occurrence. This
	could be a synonym, see also acceptedScientificName.
	"""
	scientificName: String
	"""
	The scientific name authorship for the taxon from the GBIF backbone matched to this occurrence. This could be a
	synonym, see also acceptedScientificName.
	"""
	scientificNameAuthorship: String
	"""
	The accepted scientific name (including authorship) for the taxon from the GBIF backbone matched to this
	occurrence.
	"""
	acceptedScientificName: String
	"""
	The kingdom name (excluding authorship) for the kingdom from the GBIF backbone matched to this occurrence.
	"""
	kingdom: String
	"""
	The phylum name (excluding authorship) for the phylum from the GBIF backbone matched to this occurrence.
	"""
	phylum: String
	"""
	The order name (excluding authorship) for the order from the GBIF backbone matched to this occurrence.
	"""
	order: String
	"""
	The family name (excluding authorship) for the family from the GBIF backbone matched to this occurrence.
	"""
	family: String
	"""
	The genus name (excluding authorship) for the genus from the GBIF backbone matched to this occurrence.
	"""
	genus: String
	"""
	The subgenus name (excluding authorship) for the subgenus from the GBIF backbone matched to this occurrence.
	"""
	subgenus: String
	"""
	The species name (excluding authorship) for the species from the GBIF backbone matched to this occurrence.
	"""
	species: String
	"The genus name part of the species name from the GBIF backbone matched to this occurrence."
	genericName: String
	"The specific name part of the species name from the GBIF backbone matched to this occurrence."
	specificEpithet: String
	"The infraspecific name part of the species name from the GBIF backbone matched to this occurrence."
	infraspecificEpithet: String
	"The taxonomic rank of the most specific name in the scientificName."
	taxonRank: String
	"The status of the use of the scientificName as a label for a taxon."
	taxonomicStatus: String
	"""
	The IUCN Red List Category of the taxon of this occurrence.
	See the GBIF vocabulary for the values and their definitions, and the IUCN Red List of Threatened Species
	dataset in GBIF for the version of the Red List GBIF's interpretation procedures are using.
	"""
	iucnRedListCategory: String
	"The date on which the subject was determined as representing the Taxon."
	dateIdentified: String
	"""
	The geographic latitude (in decimal degrees, using the WGS84 datum) of the geographic centre of the location of
	the occurrence.
	"""
	decimalLatitude: Float
	"""
	The geographic longitude (in decimal degrees, using the WGS84 datum) of the geographic centre of the location of
	the occurrence.
	"""
	decimalLongitude: Float
	"""
	A decimal representation of the precision of the coordinates given in the decimalLatitude and decimalLongitude.
	"""
	coordinatePrecision: Float
	"""
	The horizontal distance (in metres) from the given decimalLatitude and decimalLongitude describing the smallest
	circle containing the whole of the Location.
	"""
	coordinateUncertaintyInMeters: Float
	"**Deprecated.** This value is always null. It is an obsolete Darwin Core term."
	coordinateAccuracy: Float
	"Elevation (altitude) in metres above sea level. This is not a current Darwin Core term."
	elevation: Float
	"""
	The value of the potential error associated with the elevation. This is not a current Darwin Core term.
	"""
	elevationAccuracy: Float
	"Depth in metres below sea level. This is not a current Darwin Core term."
	depth: Float
	"The value of the potential error associated with the depth. This is not a current Darwin Core term."
	depthAccuracy: Float
	"""
	The continent, based on a 7 continent model described on Wikipedia and the World Geographical Scheme for
	Recording Plant Distributions (WGSRPD).
	In particular this splits the Americas into North and South America with North America including the Caribbean
	(except Trinidad and Tobago) and reaching down and including Panama.
	See the GBIF Continents for the exact divisions.
	*This is a geographical division. See GBIFRegion for GBIF's political divisions.*
	"""
	continent: String
	"""
	The name of the next-smaller administrative region than country (state, province, canton, department, region,
	etc.) in which the occurrence occurs.
	This value is unaltered by GBIF's processing; see also the GADM fields.
	"""
	stateProvince: String
	"""
	The administrative divisions according to the GADM database.
	This value is applied by GBIF's processing without consideration of the stateProvince, county or locality
	fields.
	"""
	gadm: GbifGadm
	"The name of the water body in which the Location occurs."
	waterBody: String
	"""
	The distance in metres of the occurrence from a centroid known to be applied to occurrences during
	georeferencing. This can potentially indicate low-precision georeferencing, check the values of
	coordinateUncertaintyInMeters and georeferenceRemarks.
	"""
	distanceFromCentroidInMeters: Float
	"""
	A list (concatenated and separated) of geographic names less specific than the information captured in the
	dwc:locality term.
	"""
	higherGeography: String
	"""
	A list (concatenated and separated) of names of people, groups, or organizations who determined the georeference
	(spatial representation) for the dcterms:Location.
	"""
	georeferencedBy: String
	"The four-digit year in which the event occurred, according to the Common Era calendar."
	year: Int
	"The integer month in which the Event occurred."
	month: Int
	"The integer day of the month on which the Event occurred."
	day: Int
	"""
	The date-time during which an Event occurred. For occurrences, this is the date-time when the event was
	recorded. Not suitable for a time in a geological context.
	"""
	eventDate: String
	"""
	The latest integer day of the year on which the Event occurred (1 for 1 January, 365 for 31 December, except in
	a leap year, in which case it is 366).
	"""
	startDayOfYear: Int
	"""
	The earliest integer day of the year on which the Event occurred (1 for 1 January, 365 for 31 December, except
	in a leap year, in which case it is 366).
	"""
	endDayOfYear: Int
	"""
	A list (concatenated and separated) of nomenclatural types (type status, typified scientific name, publication)
	applied to the occurrence.
	"""
	typeStatus: String
	"""
	The scientific name that is based on the type specimen.
	This is not yet a Darwin Core term, see the proposal to add it.
	"""
	typifiedName: String
	"""
	A specific interpretation issue found during processing and interpretation of the record.
	See the list of occurrence issues and the OccurrenceIssue enumeration for possible values and definitions.
	"""
	issues: [String]
	"The most recent date-time on which the occurrence was changed, according to the publisher."
	modified: String
	"""
	The time this occurrence was last processed by GBIF's interpretation system “Pipelines”.
	This is the time the record was last changed in GBIF, **not** the time the record was last changed by the
	publisher. Data is also reprocessed when we changed the taxonomic backbone, geographic data sources or other
	interpretation procedures.
	An earlier interpretation system distinguished between “parsing” and “interpretation”, but in the current system
	there is only one process ,  the two dates will always be the same.
	"""
	lastInterpreted: String
	"A related resource that is referenced, cited, or otherwise pointed to by the described resource."
	references: String
	"A legal document giving official permission to do something with the occurrence."
	license: String
	"A number or enumeration value for the quantity of organisms."
	organismQuantity: Float
	"The type of quantification system used for the quantity of organisms."
	organismQuantityType: String
	"""
	The unit of measurement of the size (time duration, length, area, or volume) of a sample in a sampling event.
	"""
	sampleSizeUnit: String
	"""
	A numeric value for a measurement of the size (time duration, length, area, or volume) of a sample in a sampling
	event.
	"""
	sampleSizeValue: Float
	"The relative measurement of the quantity of the organism (i.e. without absolute units)."
	relativeOrganismQuantity: Float
	"Flag occurrence when associatedSequences/extension exists"
	isSequenced: Boolean
	"""
	A list (concatenated and separated) of identifiers (publication, global unique identifier, URI) of genetic
	sequence information associated with the material entity.
	"""
	associatedSequences: String
	"Alternative identifiers for the occurrence."
	identifiers: [GbifOccurrenceIdentifier]
	"Multimedia related to te occurrence."
	media: [GbifMediaObject]
	"Measurements or facts about the the occurrence."
	facts: [GbifMeasurementOrFact]
	"Relationships between occurrences."
	relations: [GbifOccurrenceRelation]
	"**Experimental.** The UUID of the institution holding the specimen occurrence, from GRSciColl."
	institutionKey: String
	"**Experimental.** The UUID of the collection containing the specimen occurrence, from GRSciColl."
	collectionKey: String
	"""
	**Experimental.** Whether the occurrence belongs to a machine-calculated cluster of probable duplicate
	occurrences.
	"""
	isInCluster: Boolean
	"""
	An identifier for the set of data. May be a global unique identifier or an identifier specific to a collection
	or institution.
	"""
	datasetID: String
	"The name identifying the data set from which the record was derived."
	datasetName: String
	"""
	A list (concatenated and separated) of previous or alternate fully qualified catalogue numbers or other
	human-used identifiers for the same occurrence, whether in the current or any other data set or collection.
	"""
	otherCatalogNumbers: String
	"""
	The full name of the earliest possible geochronologic eon or lowest chrono-stratigraphic eonothem or the
	informal name ("Precambrian") attributable to the stratigraphic horizon from which the dwc:MaterialEntity was
	collected.
	"""
	earliestEonOrLowestEonothem: String
	"""
	The full name of the latest possible geochronologic eon or highest chrono-stratigraphic eonothem or the informal
	name ("Precambrian") attributable to the stratigraphic horizon from which the dwc:MaterialEntity was collected.
	"""
	latestEonOrHighestEonothem: String
	"""
	The full name of the earliest possible geochronologic era or lowest chronostratigraphic erathem attributable to
	the stratigraphic horizon from which the dwc:MaterialEntity was collected.
	"""
	earliestEraOrLowestErathem: String
	"""
	The full name of the latest possible geochronologic era or highest chronostratigraphic erathem attributable to
	the stratigraphic horizon from which the dwc:MaterialEntity was collected.
	"""
	latestEraOrHighestErathem: String
	"""
	The full name of the earliest possible geochronologic period or lowest chronostratigraphic system attributable
	to the stratigraphic horizon from which the dwc:MaterialEntity was collected.
	"""
	earliestPeriodOrLowestSystem: String
	"""
	The full name of the latest possible geochronologic period or highest chronostratigraphic system attributable to
	the stratigraphic horizon from which the dwc:MaterialEntity was collected.
	"""
	latestPeriodOrHighestSystem: String
	"""
	The full name of the earliest possible geochronologic epoch or lowest chronostratigraphic series attributable to
	the stratigraphic horizon from which the dwc:MaterialEntity was collected.
	"""
	earliestEpochOrLowestSeries: String
	"""
	The full name of the latest possible geochronologic epoch or highest chronostratigraphic series attributable to
	the stratigraphic horizon from which the dwc:MaterialEntity was collected.
	"""
	latestEpochOrHighestSeries: String
	"""
	The full name of the earliest possible geochronologic age or lowest chronostratigraphic stage attributable to
	the stratigraphic horizon from which the dwc:MaterialEntity was collected.
	"""
	earliestAgeOrLowestStage: String
	"""
	The full name of the latest possible geochronologic age or highest chronostratigraphic stage attributable to the
	stratigraphic horizon from which the dwc:MaterialEntity was collected.
	"""
	latestAgeOrHighestStage: String
	"""
	The full name of the lowest possible geological biostratigraphic zone of the stratigraphic horizon from which
	the dwc:MaterialEntity was collected.
	"""
	lowestBiostratigraphicZone: String
	"""
	The full name of the highest possible geological biostratigraphic zone of the stratigraphic horizon from which
	the dwc:MaterialEntity was collected.
	"""
	highestBiostratigraphicZone: String
	"The full name of the lithostratigraphic group from which the dwc:MaterialEntity was collected."
	group: String
	"The full name of the lithostratigraphic formation from which the dwc:MaterialEntity was collected."
	formation: String
	"The full name of the lithostratigraphic member from which the dwc:MaterialEntity was collected."
	member: String
	"The full name of the lithostratigraphic bed from which the dwc:MaterialEntity was collected."
	bed: String
	"A person, group, or organization responsible for recording the original occurrence."
	recordedBy: String
	"""
	A list (concatenated and separated) of names of people, groups, or organizations who assigned the Taxon to the
	occurrence.
	"""
	identifiedBy: String
	"A preparation or preservation method for a specimen."
	preparations: String
	"The methods or protocols used during an Event, denoted by an IRI."
	samplingProtocol: String
	"**Deprecated: use the nucleotideSequence instead.** The DNA sequence ID of an occurrence."
	dnaSequenceID: [String]
	"Nucleotide Sequence objects of an occurrence."
	nucleotideSequence: [GbifNucleotideSequence]
	"The scientific name as the dataset wrote it, before GBIF matched it."
	verbatimScientificName: String
	"""
	The geodetic datum for the interpreted decimal coordinates.
	Coordinates are reprojected to WGS84 if they exist, so this field is either null or WGS84.
	"""
	geodeticDatum: String
	"""
	The class name (excluding authorship) for the class from the GBIF backbone matched to this occurrence.
	"""
	class: String
	"""
	The 2-letter country code (as per ISO-3166-1) of the country, territory or area in which the occurrence was
	recorded.
	"""
	countryCode: String
	"""
	A list of the globally unique identifiers for the person, people, groups, or organizations responsible for
	recording the original Occurrence.
	"""
	recordedByIDs: [GbifAgentIdentifier]
	"""
	A list of the globally unique identifiers for the person, people, groups, or organizations responsible for
	assigning the Taxon to the occurrence.
	"""
	identifiedByIDs: [GbifAgentIdentifier]
	"""
	An enumeration for all GBIF Regions. These are based on IPBES regions.
	*This is a political division,* part of GBIF's governance structure.
	"""
	gbifRegion: String
	"""
	The title (as per ISO-3166-1) of the country, territory or area in which the occurrence was recorded.
	"""
	country: String
	"""
	An enumeration for all GBIF Regions. These are based on IPBES regions.
	*This is a political division,* part of GBIF's governance structure.
	"""
	publishedByGbifRegion: String
}

"""
The administrative areas of the GADM database that an occurrence lies in, from the country down to the third
level.
"""
type GbifGadm {
	"""
	The top-level division for a country, territory or island.
	This is usually a three-letter code from ISO 3166.
	"""
	level0: GbifGadmFeature
	"The first-level division from the GADM database."
	level1: GbifGadmFeature
	"The second-level division from the GADM database."
	level2: GbifGadmFeature
	"The third-level division from the GADM database."
	level3: GbifGadmFeature
}

"A region from the GADM database."
type GbifGadmFeature {
	"The identifier in GADM for the administrative division."
	gid: String
	"The English name in GADM for the administrative division."
	name: String
}

"Another identifier of an occurrence, such as a catalogue number in another system."
type GbifOccurrenceIdentifier {
	"""
	Other known identifier used for the same taxon. Can be a URL pointing to a webpage, an XML or RDF document, a
	DOI UUID or any other identifier.
	"""
	identifier: String
	"The optional title of an identifier, mostly for linking."
	title: String
	"Type of identifier."
	type: String
	"An HTTP link for an identifier, if a suitable, known resolver exists for the identifier type."
	identifierLink: String
}

"An image, a sound or a video of an occurrence."
type GbifMediaObject {
	"The kind of media object."
	type: String
	"The format the image is exposed in."
	format: String
	"An HTML webpage that shows the image or its metadata."
	references: String
	"The media item title."
	title: String
	"A longer description for this media item."
	description: String
	"Where the media item comes from."
	source: String
	"A class or description for whom the image is intended or useful."
	audience: String
	"The date and time this media item was created."
	created: String
	"The person that created the media item."
	creator: String
	"Any contributor in addition to the creator that helped in recording the media item."
	contributor: String
	"An entity responsible for making the media item available."
	publisher: String
	"Licence for this media item."
	license: String
	"A person or organization owning or managing rights over the media item."
	rightsHolder: String
	"The public URL that identifies and locates the media item."
	identifier: String
}

"A measurement or a fact about an occurrence, for example the weight of an animal."
type GbifMeasurementOrFact {
	"The identifier of the measurement."
	id: String
	"What was measured, for example weight."
	type: String
	"The measured value, for example 12."
	value: String
	"The unit of the value, for example kg."
	unit: String
	"The accuracy of the measurement."
	accuracy: String
	"How the measurement was made."
	method: String
	"Who made the measurement."
	determinedBy: String
	"When the measurement was made."
	determinedDate: String
	"Remarks about the measurement."
	remarks: String
}

"A relationship between two occurrences, for example a parasite and its host."
type GbifOccurrenceRelation {
	"The identifier of the relationship."
	id: String
	"The key of the occurrence that the relationship starts from."
	occurrenceId: Long
	"The key of the related occurrence."
	relatedOccurrenceId: Long
	"The kind of relationship, for example parasite of."
	type: String
	"Who established the relationship."
	accordingTo: String
	"When the relationship was established."
	establishedDate: String
	"Remarks about the relationship."
	remarks: String
}

"A nucleotide sequence."
type GbifNucleotideSequence {
	"The identifier of the sequence."
	nucleotideSequenceID: String
	"The gene that the sequence targets, for example COI."
	targetGene: String
	"The bases of the sequence."
	sequence: String
	"The number of bases in the sequence."
	sequenceLength: Int
	"The share of the bases G and C in the sequence, from 0 to 1."
	gcContent: Float
	"The share of characters outside the IUPAC codes."
	nonIupacFraction: Float
	"The share of characters that are not one of A, C, G, T and N."
	nonACGTNFraction: Float
	"The share of the base N, an unknown base, in the sequence."
	nFraction: Float
	"The number of runs of the base N that GBIF shortened."
	nRunsCapped: Int
	"True when the sequence field held natural language instead of bases."
	naturalLanguageDetected: Boolean
	"True when GBIF trimmed the ends of the sequence."
	endsTrimmed: Boolean
	"True when GBIF removed gaps or white space from the sequence."
	gapsOrWhitespaceRemoved: Boolean
	"True when the sequence is invalid."
	invalid: Boolean
}

"An identifier of a person who recorded or identified an occurrence, for example an ORCID."
type GbifAgentIdentifier {
	"The kind of identifier, for example ORCID."
	type: String
	"The identifier, for example https://orcid.org/0000-0002-1825-0097."
	value: String
}

"The number of occurrences for each value of one field, across all matches of a search."
type GbifOccurrenceFacetCounts {
	"The name of the field."
	field: String
	"The values of the field, each with its number of results."
	counts: [GbifCount]
}

"An occurrence download request."
type GbifDownloadRequest {

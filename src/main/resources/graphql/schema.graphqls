"""
A herbal substance that EMA's Committee on Herbal Medicinal Products has assessed or plans to assess.
"""
type EmaHerbalSubstance {
	"The Latin name of the herbal substance, for example Fragariae folium."
	latinName: String
	"Whether the assessment covers a combination of herbal substances."
	combination: Boolean
	"The English common name, for example Wild Strawberry Leaf."
